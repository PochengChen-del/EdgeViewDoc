<?xml version="1.0" encoding="UTF-8"?>
<db:article xmlns:db="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.2" xml:lang="en">
<db:info>
<db:title>ColorSlider2D QML Type</db:title>
<db:productname>EdgeView</db:productname>
<db:titleabbrev>EdgeView</db:titleabbrev>
<db:abstract>
<db:para>二維顏色滑桿元件。.</db:para>
<db:para>This type was introduced in Qt 6.8.</db:para>
</db:abstract>
</db:info>
<db:variablelist>
<db:varlistentry>
<db:term>Import Statement</db:term>
<db:listitem>
<db:para>import SC</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Since:</db:term>
<db:listitem>
<db:para>Qt 6.8</db:para>
</db:listitem>
</db:varlistentry>
</db:variablelist>
<db:section xml:id="details">
<db:title>Detailed Description</db:title>
<db:para>Saturation）。</db:para>
</db:section>
<db:section xml:id="property-documentation">
<db:title>Property Documentation</db:title>
<db:section xml:id="color-prop">
<db:title>color : color</db:title>
<db:para>背景顏色。</db:para>
</db:section>
<db:section xml:id="coverColor-prop">
<db:title>coverColor : color</db:title>
<db:para>覆蓋層顏色。</db:para>
</db:section>
<db:section xml:id="coverGradient-prop">
<db:title>coverGradient : Gradient</db:title>
<db:para>覆蓋層漸層色。</db:para>
</db:section>
<db:section xml:id="gradient-prop">
<db:title>gradient : Gradient</db:title>
<db:para>背景漸層色。</db:para>
</db:section>
<db:section xml:id="indicatorWidth-prop">
<db:title>indicatorWidth : real</db:title>
<db:para>指示器寬度。</db:para>
</db:section>
<db:section xml:id="radius-prop">
<db:title>radius : real</db:title>
<db:para>圓角半徑。</db:para>
<db:para>預設 4。</db:para>
</db:section>
<db:section xml:id="sizeType-prop">
<db:title>sizeType : enumeration</db:title>
<db:para>尺寸類型，控制顯示的大小。</db:para>
<db:para>預設會從父元件繼承，若未提供則依據 Global.mobile 決定：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>true → Define.SizeType.Small</db:para>
</db:listitem>
<db:listitem>
<db:para>false → Define.SizeType.Medium</db:para>
</db:listitem>
</db:itemizedlist>
<db:informaltable style="generic">
<db:thead>
<db:tr>
<db:th>
<db:para>Constant</db:para>
</db:th>
<db:th>
<db:para>Description</db:para>
</db:th>
</db:tr>
</db:thead>
<db:tr valign="top">
<db:td>
<db:para>Define.SizeType.Small</db:para>
</db:td>
<db:td>
<db:para>小尺寸</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>Define.SizeType.Medium</db:para>
</db:td>
<db:td>
<db:para>中尺寸</db:para>
</db:td>
</db:tr>
</db:informaltable>
</db:section>
<db:section xml:id="themeName-prop">
<db:title>themeName : string</db:title>
<db:para>主題名稱。</db:para>
<db:para>預設會從父元件繼承，若未提供則使用 WATheme.systemThemeName。</db:para>
</db:section>
<db:section xml:id="themeStyle-prop">
<db:title>[read-only] themeStyle : var</db:title>
<db:para>主題樣式設定物件。</db:para>
<db:para>此屬性為唯讀，透過 <db:link xlink:href="qml-sc-colorslider2d.xml#getThemeStyle-method">getThemeStyle</db:link>() 動態產生。</db:para>
</db:section>
<db:section xml:id="xValue-prop">
<db:title>xValue : real</db:title>
<db:para>垂直值（0.0 ~ 1.0），對應指示器的 Y 軸位置。</db:para>
<db:para>由外部根據位置更新。</db:para>
</db:section>
<db:section xml:id="yValue-prop">
<db:title>yValue : real</db:title>
<db:para>垂直值（0.0 ~ 1.0），對應指示器的 Y 軸位置。</db:para>
<db:para>由外部根據位置更新。</db:para>
</db:section>
</db:section>
<db:section xml:id="signal-documentation">
<db:title>Signal Documentation</db:title>
<db:section xml:id="mousePositionChanged-signal">
<db:title>mousePositionChanged()</db:title>
<db:para>當滑鼠點擊或移動時觸發。</db:para>
<db:note>
<db:para>The corresponding handler is <db:code>onMousePositionChanged</db:code>.</db:para>
</db:note>
</db:section>
</db:section>
<db:section xml:id="method-documentation">
<db:title>Method Documentation</db:title>
<db:section xml:id="getThemeStyle-method">
<db:title>object getThemeStyle()</db:title>
<db:para>取得主題樣式設定物件。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>return</db:code></db:emphasis>主題樣式設定物件。</db:para>
</db:section>
</db:section>
</db:article>
