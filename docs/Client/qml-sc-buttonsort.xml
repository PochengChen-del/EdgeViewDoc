<?xml version="1.0" encoding="UTF-8"?>
<db:article xmlns:db="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.2" xml:lang="en">
<db:info>
<db:title>ButtonSort QML Type</db:title>
<db:productname>EdgeView</db:productname>
<db:titleabbrev>EdgeView</db:titleabbrev>
<db:abstract>
<db:para>排序按鈕元件。.</db:para>
<db:para>This type was introduced in Qt 6.8.</db:para>
</db:abstract>
</db:info>
<db:variablelist>
<db:varlistentry>
<db:term>Import Statement</db:term>
<db:listitem>
<db:para>import SC</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Since:</db:term>
<db:listitem>
<db:para>Qt 6.8</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Inherits:</db:term>
<db:listitem>
<db:para><db:link xlink:href="qml-sc-buttonbase.xml">ButtonBase</db:link></db:para>
</db:listitem>
</db:varlistentry>
</db:variablelist>
<db:section xml:id="details">
<db:title>Detailed Description</db:title>
<db:para>圖示會依據 <db:link xlink:href="qml-sc-buttonsort.xml#sortType-prop">sortType</db:link> 自動切換對應狀態：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>無排序（-1）</db:para>
</db:listitem>
<db:listitem>
<db:para>升冪（Qt.AscendingOrder）</db:para>
</db:listitem>
<db:listitem>
<db:para>降冪（Qt.DescendingOrder）</db:para>
</db:listitem>
</db:itemizedlist>
<db:para>各狀態會對應不同的 SVG 圖示資源。</db:para>
</db:section>
<db:section xml:id="property-documentation">
<db:title>Property Documentation</db:title>
<db:section xml:id="contentCheckedColorType-prop">
<db:title>contentCheckedColorType : int</db:title>
<db:para>排序啟用的圖示顏色類型。</db:para>
</db:section>
<db:section xml:id="contentThemeStyle-prop">
<db:title>[read-only] contentThemeStyle : var</db:title>
<db:para>排序啟用時的圖示顏色樣式。</db:para>
</db:section>
<db:section xml:id="isAscending-prop">
<db:title>[read-only] isAscending : bool</db:title>
<db:para>是否為升冪排序。</db:para>
</db:section>
<db:section xml:id="isDescending-prop">
<db:title>[read-only] isDescending : bool</db:title>
<db:para>是否為降冪排序。</db:para>
</db:section>
<db:section xml:id="sortType-prop">
<db:title>sortType : int</db:title>
<db:para>排序類型。</db:para>
<db:para>預設 -1。</db:para>
<db:informaltable style="generic">
<db:thead>
<db:tr>
<db:th>
<db:para>Constant</db:para>
</db:th>
<db:th>
<db:para>Description</db:para>
</db:th>
</db:tr>
</db:thead>
<db:tr valign="top">
<db:td>
<db:para>-1</db:para>
</db:td>
<db:td>
<db:para>無排序。</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>Qt.AscendingOrder</db:para>
</db:td>
<db:td>
<db:para>升冪。</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>Qt.DescendingOrder</db:para>
</db:td>
<db:td>
<db:para>降冪。</db:para>
</db:td>
</db:tr>
</db:informaltable>
</db:section>
</db:section>
</db:article>
