<?xml version="1.0" encoding="UTF-8"?>
<db:article xmlns:db="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.2" xml:lang="en">
<db:info>
<db:title>ButtonTextIcon QML Type</db:title>
<db:productname>EdgeView</db:productname>
<db:titleabbrev>EdgeView</db:titleabbrev>
<db:abstract>
<db:para>文字與圖示按鈕元件。.</db:para>
<db:para>This type was introduced in Qt 6.8.</db:para>
</db:abstract>
</db:info>
<db:variablelist>
<db:varlistentry>
<db:term>Import Statement</db:term>
<db:listitem>
<db:para>import SC</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Since:</db:term>
<db:listitem>
<db:para>Qt 6.8</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Inherited By:</db:term>
<db:listitem>
<db:para><db:link xlink:href="qml-sc-tablebuttontexticon.xml" xlink:role="">TableButtonTextIcon</db:link></db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Inherits:</db:term>
<db:listitem>
<db:para><db:link xlink:href="qml-sc-buttonbase.xml">ButtonBase</db:link></db:para>
</db:listitem>
</db:varlistentry>
</db:variablelist>
<db:section xml:id="details">
<db:title>Detailed Description</db:title>
<db:para>為同時顯示文字與圖示的按鈕元件， 繼承 <db:link xlink:href="qml-sc-buttonbase.xml">ButtonBase</db:link>，並擴充文字與圖示相關狀態控制。</db:para>
<db:para>圖示可透過 <db:link xlink:href="qml-sc-buttontexticon.xml#iconAlign-prop">iconAlign</db:link> 控制相對位置， 並支援水平或垂直排列。</db:para>
</db:section>
<db:section xml:id="property-documentation">
<db:title>Property Documentation</db:title>
<db:section xml:id="iconAlign-prop">
<db:title>iconAlign : int</db:title>
<db:para>圖示相對於文字的位置。</db:para>
<db:para>預設 Qt.AlignLeft。</db:para>
<db:informaltable style="generic">
<db:thead>
<db:tr>
<db:th>
<db:para>Constant</db:para>
</db:th>
<db:th>
<db:para>Description</db:para>
</db:th>
</db:tr>
</db:thead>
<db:tr valign="top">
<db:td>
<db:para>Qt.AlignLeft</db:para>
</db:td>
<db:td>
<db:para>左方。</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>Qt.AlignRight</db:para>
</db:td>
<db:td>
<db:para>右方。</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>Qt.AlignTop</db:para>
</db:td>
<db:td>
<db:para>上方。</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>Qt.AlignBottom</db:para>
</db:td>
<db:td>
<db:para>下方。</db:para>
</db:td>
</db:tr>
</db:informaltable>
</db:section>
<db:section xml:id="iconColor-prop">
<db:title>iconColor : StateColor</db:title>
<db:para>各狀態圖示顏色設定。</db:para>
</db:section>
<db:section xml:id="iconSourceUrl-prop">
<db:title>iconSourceUrl : url</db:title>
<db:para>圖示來源 URL。</db:para>
<db:para>詳細格式與限制請參考 Qt 官方文件。</db:para>
<db:para>暫時使用 string 型別。</db:para>
</db:section>
<db:section xml:id="iconText-prop">
<db:title>iconText : string</db:title>
<db:para>圖示文字內容。</db:para>
</db:section>
<db:section xml:id="iconTextColor-prop">
<db:title>iconTextColor : StateColor</db:title>
<db:para>各狀態圖示文字顏色設定。</db:para>
</db:section>
<db:section xml:id="isVertical-prop">
<db:title>[read-only] isVertical : bool</db:title>
<db:para>圖示與文字是否垂直排列。</db:para>
<db:para>當 <db:link xlink:href="qml-sc-buttontexticon.xml#iconAlign-prop">iconAlign</db:link> 為 <db:code>Qt.AlignTop</db:code> 或 <db:code>Qt.AlignBottom</db:code> 時為 true。</db:para>
</db:section>
<db:section xml:id="lineHeight-prop">
<db:title>lineHeight : real</db:title>
<db:para>文字行高。</db:para>
</db:section>
<db:section xml:id="showIcon-prop">
<db:title>showIcon : bool</db:title>
<db:para>是否顯示圖示。</db:para>
</db:section>
<db:section xml:id="showIconText-prop">
<db:title>showIconText : bool</db:title>
<db:para>是否顯示圖示文字。</db:para>
</db:section>
<db:section xml:id="textColor-prop">
<db:title>textColor : StateColor</db:title>
<db:para>各狀態文字顏色設定。</db:para>
</db:section>
</db:section>
</db:article>
