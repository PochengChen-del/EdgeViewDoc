<db:title>titleFont : font</db:title>
<db:para>文字字型。</db:para>
</db:section>
<db:section xml:id="titleLineHeight-prop">
<db:title>titleLineHeight : real</db:title>
<db:para>文字行高。</db:para>
</db:section>
<db:section xml:id="titleMaxLineCount-prop">
