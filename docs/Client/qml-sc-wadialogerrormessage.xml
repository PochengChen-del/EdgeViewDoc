<db:section xml:id="details">
<db:title>Detailed Description</db:title>
<db:para>支援功能：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>主題樣式控制（<db:link xlink:href="">themeName）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>多尺寸顯示（<db:link xlink:href="">sizeType）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>顯示模式（<db:link xlink:href="">position）</db:link></db:para>
<db:itemizedlist>
<db:listitem>
<db:para>Relative（依附於來源元件）</db:para>
</db:listitem>
<db:listitem>
<db:para>Bottom（全螢幕底部彈出）</db:para>
</db:listitem>
</db:itemizedlist>
</db:listitem>
<db:listitem>
<db:para>大小控制</db:para>
</db:listitem>
<db:listitem>
<db:para>滾動控制</db:para>
</db:listitem>
<db:listitem>
<db:para>錯誤訊息列表顯示（<db:link xlink:href="">errorModel）</db:link></db:para>
</db:listitem>
</db:itemizedlist>
</db:section>
<db:section xml:id="property-documentation">
<db:title>Property Documentation</db:title>
<db:section xml:id="errorModel-prop">
<db:title>errorModel : var</db:title>
<db:para>錯誤資料來源。</db:para>
</db:section>
<db:section xml:id="errorTextRole-prop">
<db:title>errorTextRole : string</db:title>
<db:para>錯誤內容欄位名稱。</db:para>
<db:para>預設 &quot;text&quot;。</db:para>
</db:section>
<db:section xml:id="errorTitleRole-prop">
<db:title>errorTitleRole : string</db:title>
<db:para>錯誤標題欄位名稱。</db:para>
<db:para>預設 &quot;title&quot;。</db:para>
</db:section>
</db:section>
<db:section xml:id="method-documentation">
<db:title>Method Documentation</db:title>
<db:section xml:id="errorTextI18nText-method">
<db:title>string errorTextI18nText(var <db:emphasis>errData</db:emphasis>)</db:title>
<db:para>取得顯示錯誤內容文字。</db:para>
<db:para>可覆寫。</db:para>
</db:section>
<db:section xml:id="errorTitleI18nText-method">
<db:title>string errorTitleI18nText(var <db:emphasis>errData</db:emphasis>)</db:title>
<db:para>取得顯示錯誤標題文字。</db:para>
<db:para>可覆寫。</db:para>
</db:section>
</db:section>
