<?xml version="1.0" encoding="UTF-8"?>
<db:article xmlns:db="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.2" xml:lang="en">
<db:info>
<db:title>InfoFooterRow QML Type</db:title>
<db:productname>EdgeView</db:productname>
<db:titleabbrev>EdgeView</db:titleabbrev>
<db:abstract>
<db:para>水平排列未登入頁面 Footer。.</db:para>
<db:para>This type was introduced in Qt 6.8.</db:para>
</db:abstract>
</db:info>
<db:variablelist>
<db:varlistentry>
<db:term>Import Statement</db:term>
<db:listitem>
<db:para>import SC</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Since:</db:term>
<db:listitem>
<db:para>Qt 6.8</db:para>
</db:listitem>
</db:varlistentry>
</db:variablelist>
<db:section xml:id="details">
<db:title>Detailed Description</db:title>
<db:para>元件組成：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>公司版權資訊</db:para>
</db:listitem>
<db:listitem>
<db:para>系統版本資訊（自訂）</db:para>
</db:listitem>
<db:listitem>
<db:para>功能按鈕列表</db:para>
</db:listitem>
<db:listitem>
<db:para>語言切換下拉選單</db:para>
</db:listitem>
</db:itemizedlist>
<db:para>支援功能：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>主題樣式控制（<db:link xlink:href="">themeName）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>多尺寸顯示（<db:link xlink:href="">sizeType）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>功能按鈕控制</db:para>
</db:listitem>
<db:listitem>
<db:para>語言切換</db:para>
</db:listitem>
</db:itemizedlist>
</db:section>
<db:section xml:id="property-documentation">
<db:title>Property Documentation</db:title>
<db:section xml:id="bottomPadding-prop">
<db:title>bottomPadding : real</db:title>
<db:para>下方邊距。</db:para>
</db:section>
<db:section xml:id="buttonKeyRole-prop">
<db:title>buttonKeyRole : string</db:title>
<db:para>按鈕文字欄位名稱。</db:para>
<db:para>預設 &quot;key&quot;。</db:para>
</db:section>
<db:section xml:id="buttonModel-prop">
<db:title>buttonModel : var</db:title>
<db:para>功能按鈕來源。</db:para>
</db:section>
<db:section xml:id="buttonOpenUrlRole-prop">
<db:title>buttonOpenUrlRole : string</db:title>
<db:para>按鈕開啟 URL 欄位名稱。</db:para>
<db:para>若存在且為有效字串，點擊時會呼叫 Global.openUrlExternally()。</db:para>
</db:section>
<db:section xml:id="leftPadding-prop">
<db:title>leftPadding : real</db:title>
<db:para>左方邊距。</db:para>
</db:section>
<db:section xml:id="padding-prop">
<db:title>padding : real</db:title>
<db:para>邊距。</db:para>
</db:section>
<db:section xml:id="rightPadding-prop">
<db:title>rightPadding : real</db:title>
<db:para>右方邊距。</db:para>
</db:section>
<db:section xml:id="showVersion-prop">
<db:title>showVersion : bool</db:title>
<db:para>是否顯示版本資訊。</db:para>
<db:para>預設 true。</db:para>
</db:section>
<db:section xml:id="sizeType-prop">
<db:title>sizeType : enumeration</db:title>
<db:para>尺寸類型，控制顯示的大小。</db:para>
<db:para>預設會從父元件繼承，若未提供則依據 Global.mobile 決定：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>true → Define.SizeType.Small</db:para>
</db:listitem>
<db:listitem>
<db:para>false → Define.SizeType.Medium</db:para>
</db:listitem>
</db:itemizedlist>
<db:informaltable style="generic">
<db:thead>
<db:tr>
<db:th>
<db:para>Constant</db:para>
</db:th>
<db:th>
<db:para>Description</db:para>
</db:th>
</db:tr>
</db:thead>
<db:tr valign="top">
<db:td>
<db:para>Define.SizeType.Small</db:para>
</db:td>
<db:td>
<db:para>小尺寸</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>Define.SizeType.Medium</db:para>
</db:td>
<db:td>
<db:para>中尺寸</db:para>
</db:td>
</db:tr>
</db:informaltable>
</db:section>
<db:section xml:id="spacing-prop">
<db:title>spacing : real</db:title>
<db:para>間距。</db:para>
</db:section>
<db:section xml:id="themeName-prop">
<db:title>themeName : string</db:title>
<db:para>主題名稱。</db:para>
<db:para>預設會從父元件繼承，若未提供則使用 WATheme.systemThemeName。</db:para>
</db:section>
<db:section xml:id="themeStyle-prop">
<db:title>[read-only] themeStyle : var</db:title>
<db:para>主題樣式設定物件。</db:para>
<db:para>此屬性為唯讀，透過 <db:link xlink:href="qml-sc-infofooterrow.xml#getThemeStyle-method">getThemeStyle</db:link>() 動態產生。</db:para>
</db:section>
<db:section xml:id="today-prop">
<db:title>today : date</db:title>
<db:para>今日日期，用於顯示版權年份。</db:para>
</db:section>
<db:section xml:id="topPadding-prop">
<db:title>topPadding : real</db:title>
<db:para>上方邊距。</db:para>
</db:section>
<db:section xml:id="versionText-prop">
<db:title>versionText : string</db:title>
<db:para>系統版本資訊文字，使用換行字元（\n）分隔多組。</db:para>
</db:section>
</db:section>
<db:section xml:id="method-documentation">
<db:title>Method Documentation</db:title>
<db:section xml:id="buttonClicked-method">
<db:title>void buttonClicked(var <db:emphasis>btn</db:emphasis>)</db:title>
<db:para>自訂按鈕點擊行為。</db:para>
<db:para>當按鈕未設定 openUrl 時會觸發此方法。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>param</db:code></db:emphasis>btn 按鈕資料</db:para>
</db:section>
<db:section xml:id="buttonI18nText-method">
<db:title>string buttonI18nText(var <db:emphasis>btn</db:emphasis>)</db:title>
<db:para>取得按鈕顯示文字（含 i18n）。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>param</db:code></db:emphasis>btn 按鈕資料物件或字串 <db:emphasis role="bold">&lt;Unknown command&gt;<db:code>return</db:code></db:emphasis> 對應顯示文字</db:para>
</db:section>
<db:section xml:id="getThemeStyle-method">
<db:title>object getThemeStyle()</db:title>
<db:para>取得主題樣式設定物件。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>return</db:code></db:emphasis>主題樣式設定物件。</db:para>
</db:section>
</db:section>
</db:article>
