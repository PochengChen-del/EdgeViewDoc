<?xml version="1.0" encoding="UTF-8"?>
<db:article xmlns:db="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.2" xml:lang="en">
<db:info>
<db:title>NavigationItem QML Type</db:title>
<db:productname>EdgeView</db:productname>
<db:titleabbrev>EdgeView</db:titleabbrev>
<db:abstract>
<db:para>導覽項目元件。.</db:para>
<db:para>This type was introduced in Qt 6.8.</db:para>
</db:abstract>
</db:info>
<db:variablelist>
<db:varlistentry>
<db:term>Import Statement</db:term>
<db:listitem>
<db:para>import SC</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Since:</db:term>
<db:listitem>
<db:para>Qt 6.8</db:para>
</db:listitem>
</db:varlistentry>
</db:variablelist>
<db:section xml:id="details">
<db:title>Detailed Description</db:title>
<db:para>支援功能：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>主題樣式控制（<db:link xlink:href="">themeName）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>多尺寸顯示（<db:link xlink:href="">sizeType）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>文字顯示（<db:link xlink:href="">text）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>圖示顯示（<db:link xlink:href="">iconSourceUrl）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>步驟顯示（<db:link xlink:href="">step）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>多層級縮排控制（<db:link xlink:href="">level）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>收折/展開控制（<db:link xlink:href="">expanded）</db:link></db:para>
</db:listitem>
</db:itemizedlist>
<db:para>元件內建互動狀態：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>normal</db:para>
</db:listitem>
<db:listitem>
<db:para>hover</db:para>
</db:listitem>
<db:listitem>
<db:para>active</db:para>
</db:listitem>
<db:listitem>
<db:para>disable</db:para>
</db:listitem>
</db:itemizedlist>
<db:para>各狀態會繼承對應的 base state（例如 normal → normalbase）， 並透過 <db:link xlink:href="qml-sc-navigationitem.xml#themeStyle-prop">themeStyle</db:link> 套用背景、邊框與內容顏色等。</db:para>
<db:para>樣式由 <db:link xlink:href="qml-sc-navigationitem.xml#style-prop">style</db:link> 決定。</db:para>
</db:section>
<db:section xml:id="property-documentation">
<db:title>Property Documentation</db:title>
<db:section xml:id="activeBaseState-prop">
<db:title>[read-only] activeBaseState : State</db:title>
<db:para>active 狀態基礎設定。由 active 繼承。</db:para>
</db:section>
<db:section xml:id="activeState-prop">
<db:title>activeState : State</db:title>
<db:para>active 狀態設定（繼承 activebase）。</db:para>
</db:section>
<db:section xml:id="actived-prop">
<db:title>actived : bool</db:title>
<db:para>是否為 active。</db:para>
<db:para>預設綁定 pressed。</db:para>
</db:section>
<db:section xml:id="bgColor-prop">
<db:title>bgColor : StateColor</db:title>
<db:para>各狀態背景顏色設定。</db:para>
</db:section>
<db:section xml:id="bgCoverGradient-prop">
<db:title>bgCoverGradient : StateGradient</db:title>
<db:para>各狀態背景漸層設定。</db:para>
</db:section>
<db:section xml:id="disableBaseState-prop">
<db:title>[read-only] disableBaseState : State</db:title>
<db:para>disable 狀態基礎設定。由 disable 繼承。</db:para>
</db:section>
<db:section xml:id="disableState-prop">
<db:title>disableState : State</db:title>
<db:para>disable 狀態設定（繼承 disablebase）。</db:para>
</db:section>
<db:section xml:id="divColor-prop">
<db:title>divColor : StateColor</db:title>
<db:para>各狀態 Divider 顏色設定。</db:para>
</db:section>
<db:section xml:id="expanded-prop">
<db:title>expanded : bool</db:title>
<db:para>是否為展開狀態。</db:para>
</db:section>
<db:section xml:id="hoverBaseState-prop">
<db:title>[read-only] hoverBaseState : State</db:title>
<db:para>hover 狀態基礎設定。由 hover 繼承。</db:para>
</db:section>
<db:section xml:id="hoverState-prop">
<db:title>hoverState : State</db:title>
<db:para>hover 狀態設定（繼承 hoverbase）。</db:para>
</db:section>
<db:section xml:id="iconColor-prop">
<db:title>iconColor : StateColor</db:title>
<db:para>各狀態圖示顏色設定。</db:para>
</db:section>
<db:section xml:id="iconSourceUrl-prop">
<db:title>iconSourceUrl : url</db:title>
<db:para>圖示來源 URL。</db:para>
<db:para>當 <db:link xlink:href="qml-sc-navigationitem.xml#style-prop">style</db:link> 為 Define.NavStyle.Icon 時使用。</db:para>
<db:para>詳細格式與限制請參考 Qt 官方文件。</db:para>
<db:para>暫時使用 string 型別。</db:para>
</db:section>
<db:section xml:id="isIcon-prop">
<db:title>[read-only] isIcon : bool</db:title>
<db:para>是否為圖示模式。</db:para>
</db:section>
<db:section xml:id="isStep-prop">
<db:title>[read-only] isStep : bool</db:title>
<db:para>是否為步驟模式。</db:para>
</db:section>
<db:section xml:id="level-prop">
<db:title>level : int</db:title>
<db:para>導覽階層層級，控制左側縮排與階層線顯示。</db:para>
</db:section>
<db:section xml:id="nextPadding-prop">
<db:title>[read-only] nextPadding : real</db:title>
<db:para>下一層級縮排距離。</db:para>
</db:section>
<db:section xml:id="normalBaseState-prop">
<db:title>[read-only] normalBaseState : State</db:title>
<db:para>normal 狀態基礎設定。由 normal 繼承。</db:para>
</db:section>
<db:section xml:id="normalState-prop">
<db:title>normalState : State</db:title>
<db:para>normal 狀態設定（繼承 normalbase）。</db:para>
</db:section>
<db:section xml:id="notified-prop">
<db:title>notified : bool</db:title>
<db:para>是否顯示通知提示。</db:para>
<db:para>啟用後會於圖示右上角顯示提示點。</db:para>
</db:section>
<db:section xml:id="showFold-prop">
<db:title>showFold : bool</db:title>
<db:para>是否顯示收折按鈕。</db:para>
</db:section>
<db:section xml:id="showText-prop">
<db:title>showText : bool</db:title>
<db:para>是否顯示文字內容。</db:para>
</db:section>
<db:section xml:id="sizeType-prop">
<db:title>sizeType : enumeration</db:title>
<db:para>尺寸類型，控制顯示的大小。</db:para>
<db:para>預設會從父元件繼承，若未提供則依據 Global.mobile 決定：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>true → Define.SizeType.Small</db:para>
</db:listitem>
<db:listitem>
<db:para>false → Define.SizeType.Medium</db:para>
</db:listitem>
</db:itemizedlist>
<db:informaltable style="generic">
<db:thead>
<db:tr>
<db:th>
<db:para>Constant</db:para>
</db:th>
<db:th>
<db:para>Description</db:para>
</db:th>
</db:tr>
</db:thead>
<db:tr valign="top">
<db:td>
<db:para>Define.SizeType.Small</db:para>
</db:td>
<db:td>
<db:para>小尺寸</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>Define.SizeType.Medium</db:para>
</db:td>
<db:td>
<db:para>中尺寸</db:para>
</db:td>
</db:tr>
</db:informaltable>
</db:section>
<db:section xml:id="step-prop">
<db:title>step : int</db:title>
<db:para>步驟編號。</db:para>
<db:para>當 <db:link xlink:href="qml-sc-navigationitem.xml#style-prop">style</db:link> 為 Define.NavStyle.Step 時顯示。</db:para>
</db:section>
<db:section xml:id="stepTextColor-prop">
<db:title>stepTextColor : StateColor</db:title>
<db:para>各狀態 顏色設定。</db:para>
</db:section>
<db:section xml:id="style-prop">
<db:title>style : enumeration</db:title>
<db:para>導覽項目樣式。</db:para>
<db:para>預設 Define.NavStyle.None。</db:para>
<db:informaltable style="generic">
<db:thead>
<db:tr>
<db:th>
<db:para>Constant</db:para>
</db:th>
<db:th>
<db:para>Description</db:para>
</db:th>
</db:tr>
</db:thead>
<db:tr valign="top">
<db:td>
<db:para>Define.NavStyle.None</db:para>
</db:td>
<db:td>
<db:para>無樣式。</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>Define.NavStyle.Step</db:para>
</db:td>
<db:td>
<db:para>步驟樣式。</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>Define.NavStyle.Icon</db:para>
</db:td>
<db:td>
<db:para>圖示樣式。</db:para>
</db:td>
</db:tr>
</db:informaltable>
</db:section>
<db:section xml:id="textColor-prop">
<db:title>textColor : StateColor</db:title>
<db:para>各狀態文字顏色設定。</db:para>
</db:section>
<db:section xml:id="textElide-prop">
<db:title>textElide : enumeration</db:title>
<db:para>文字省略模式。</db:para>
</db:section>
<db:section xml:id="textMaxLineCount-prop">
<db:title>textMaxLineCount : int</db:title>
<db:para>文字最大行數限制。</db:para>
<db:para>當 <db:link xlink:href="qml-sc-navigationitem.xml#textWrapMode-prop">textWrapMode</db:link> 允許多行時，此屬性用來限制最多顯示行數。設為 0 表示不限制行數。</db:para>
</db:section>
<db:section xml:id="textWrapMode-prop">
<db:title>textWrapMode : enumeration</db:title>
<db:para>文字換行模式。</db:para>
</db:section>
<db:section xml:id="themeName-prop">
<db:title>themeName : string</db:title>
<db:para>主題名稱。</db:para>
<db:para>預設會從父元件繼承，若未提供則使用 WATheme.systemThemeName。</db:para>
</db:section>
<db:section xml:id="themeStyle-prop">
<db:title>[read-only] themeStyle : var</db:title>
<db:para>主題樣式設定物件。</db:para>
<db:para>此屬性為唯讀，透過 <db:link xlink:href="qml-sc-navigationitem.xml#getThemeStyle-method">getThemeStyle</db:link>() 動態產生。</db:para>
</db:section>
</db:section>
<db:section xml:id="signal-documentation">
<db:title>Signal Documentation</db:title>
<db:section xml:id="foldClicked-signal">
<db:title>foldClicked()</db:title>
<db:para>點擊收折按鈕時觸發。</db:para>
<db:note>
<db:para>The corresponding handler is <db:code>onFoldClicked</db:code>.</db:para>
</db:note>
</db:section>
</db:section>
<db:section xml:id="method-documentation">
<db:title>Method Documentation</db:title>
<db:section xml:id="getThemeStyle-method">
<db:title>object getThemeStyle()</db:title>
<db:para>取得主題樣式設定物件。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>return</db:code></db:emphasis>主題樣式設定物件。</db:para>
</db:section>
</db:section>
</db:article>
