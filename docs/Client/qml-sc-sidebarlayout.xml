<?xml version="1.0" encoding="UTF-8"?>
<db:article xmlns:db="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.2" xml:lang="en">
<db:info>
<db:title>SidebarLayout QML Type</db:title>
<db:productname>EdgeView</db:productname>
<db:titleabbrev>EdgeView</db:titleabbrev>
<db:abstract>
<db:para>側邊欄面配置容器。.</db:para>
<db:para>This type was introduced in Qt 6.8.</db:para>
</db:abstract>
</db:info>
<db:variablelist>
<db:varlistentry>
<db:term>Import Statement</db:term>
<db:listitem>
<db:para>import SC</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Since:</db:term>
<db:listitem>
<db:para>Qt 6.8</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Inherited By:</db:term>
<db:listitem>
<db:para><db:link xlink:href="qml-sc-sidebarsearchtarget.xml" xlink:role="">SidebarSearchTarget</db:link></db:para>
</db:listitem>
</db:varlistentry>
</db:variablelist>
<db:section xml:id="details">
<db:title>Detailed Description</db:title>
<db:para>元件組成：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>Header：標題列與關閉按鈕</db:para>
</db:listitem>
<db:listitem>
<db:para>Content：主要內容區域</db:para>
</db:listitem>
<db:listitem>
<db:para>Footer：底部操作區域</db:para>
</db:listitem>
</db:itemizedlist>
<db:para>支援功能：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>主題樣式控制（<db:link xlink:href="">themeName）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>自訂內容區（<db:link xlink:href="">contentItem）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>自訂 Footer 區域（<db:link xlink:href="">footerItems）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>展開/收合控制（<db:link xlink:href="qml-sc-sidebarlayout.xml#expand-method">expand</db:link>() / <db:link xlink:href="">collapse()）</db:link></db:para>
</db:listitem>
</db:itemizedlist>
</db:section>
<db:section xml:id="property-documentation">
<db:title>Property Documentation</db:title>
<db:section xml:id="contentItem-prop">
<db:title>contentItem : Item</db:title>
<db:para>內容區域的子元件。</db:para>
</db:section>
<db:section xml:id="expanded-prop">
<db:title>[read-only] expanded : bool</db:title>
<db:para>是否展開。</db:para>
<db:para>此屬性會同步父層容器的 expanded 狀態。</db:para>
</db:section>
<db:section xml:id="footerItems-prop">
<db:title>footerItems : Item</db:title>
<db:para>Footer 元件。</db:para>
</db:section>
<db:section xml:id="showFooter-prop">
<db:title>showFooter : bool</db:title>
<db:para>是否顯示 Footer。</db:para>
</db:section>
<db:section xml:id="themeName-prop">
<db:title>themeName : string</db:title>
<db:para>主題名稱。</db:para>
<db:para>預設會從父元件繼承，若未提供則使用 WATheme.systemThemeName。</db:para>
</db:section>
<db:section xml:id="themeStyle-prop">
<db:title>[read-only] themeStyle : var</db:title>
<db:para>主題樣式設定物件。</db:para>
<db:para>此屬性為唯讀，透過 <db:link xlink:href="qml-sc-sidebarlayout.xml#getThemeStyle-method">getThemeStyle</db:link>() 動態產生。</db:para>
</db:section>
<db:section xml:id="title-prop">
<db:title>title : string</db:title>
<db:para>標題文字。</db:para>
</db:section>
</db:section>
<db:section xml:id="signal-documentation">
<db:title>Signal Documentation</db:title>
<db:section xml:id="closeClicked-signal">
<db:title>closeClicked()</db:title>
<db:para>點擊關閉按鈕時觸發。</db:para>
<db:note>
<db:para>The corresponding handler is <db:code>onCloseClicked</db:code>.</db:para>
</db:note>
</db:section>
</db:section>
<db:section xml:id="method-documentation">
<db:title>Method Documentation</db:title>
<db:section xml:id="collapse-method">
<db:title>collapse()</db:title>
<db:para>收合側邊欄。</db:para>
<db:para>若父元件存在 collapse() 方法則會自動呼叫。</db:para>
</db:section>
<db:section xml:id="expand-method">
<db:title>expand()</db:title>
<db:para>展開側邊欄。</db:para>
<db:para>若父元件存在 expand() 方法則會自動呼叫。</db:para>
</db:section>
<db:section xml:id="getThemeStyle-method">
<db:title>object getThemeStyle()</db:title>
<db:para>取得主題樣式設定物件。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>return</db:code></db:emphasis>主題樣式設定物件。</db:para>
</db:section>
</db:section>
</db:article>
