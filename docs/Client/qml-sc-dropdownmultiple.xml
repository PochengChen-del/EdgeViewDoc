<?xml version="1.0" encoding="UTF-8"?>
<db:article xmlns:db="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.2" xml:lang="en">
<db:info>
<db:title>DropdownMultiple QML Type</db:title>
<db:productname>EdgeView</db:productname>
<db:titleabbrev>EdgeView</db:titleabbrev>
<db:abstract>
<db:para>多選下拉選單元件。.</db:para>
<db:para>This type was introduced in Qt 6.8.</db:para>
</db:abstract>
</db:info>
<db:variablelist>
<db:varlistentry>
<db:term>Import Statement</db:term>
<db:listitem>
<db:para>import SC</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Since:</db:term>
<db:listitem>
<db:para>Qt 6.8</db:para>
</db:listitem>
</db:varlistentry>
</db:variablelist>
<db:section xml:id="details">
<db:title>Detailed Description</db:title>
<db:para>此元件與其他輸入元件提供一致的互動行為與樣式。</db:para>
<db:para>支援功能：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>主題樣式控制（<db:link xlink:href="">themeName）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>多尺寸顯示（<db:link xlink:href="">sizeType）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>文字顯示（<db:link xlink:href="">text）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>圖示顯示（<db:link xlink:href="">iconSourceUrl）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>彈跳框控制（popup）</db:para>
</db:listitem>
<db:listitem>
<db:para>Delegate 控制（<db:link xlink:href="qml-sc-dropdownmultiple.xml#delegateRelative-prop">delegateRelative</db:link> / <db:link xlink:href="">delegateBottom）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>分組與多選控制（<db:link xlink:href="qml-sc-dropdownmultiple.xml#showSelectAll-prop">showSelectAll</db:link>, <db:link xlink:href="">useSection）</db:link></db:para>
</db:listitem>
</db:itemizedlist>
<db:para>元件內建互動狀態：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>normal</db:para>
</db:listitem>
<db:listitem>
<db:para>hover</db:para>
</db:listitem>
<db:listitem>
<db:para>active</db:para>
</db:listitem>
<db:listitem>
<db:para>disable</db:para>
</db:listitem>
</db:itemizedlist>
<db:para>各狀態會繼承對應的 base state（例如 normal → normalbase）， 並透過 <db:link xlink:href="qml-sc-dropdownmultiple.xml#themeStyle-prop">themeStyle</db:link> 套用背景、邊框與內容顏色等。</db:para>
</db:section>
<db:section xml:id="property-documentation">
<db:title>Property Documentation</db:title>
<db:section xml:id="activeBaseState-prop">
<db:title>[read-only] activeBaseState : State</db:title>
<db:para>active 狀態基礎設定。由 active 繼承。</db:para>
</db:section>
<db:section xml:id="activeState-prop">
<db:title>activeState : State</db:title>
<db:para>active 狀態設定（繼承 activebase）。</db:para>
</db:section>
<db:section xml:id="actived-prop">
<db:title>actived : bool</db:title>
<db:para>是否為 active。</db:para>
<db:para>預設綁定 focus。</db:para>
</db:section>
<db:section xml:id="bdColor-prop">
<db:title>bdColor : StateColor</db:title>
<db:para>各狀態邊框顏色設定。</db:para>
</db:section>
<db:section xml:id="bgColor-prop">
<db:title>bgColor : StateColor</db:title>
<db:para>各狀態背景顏色設定。</db:para>
</db:section>
<db:section xml:id="bgCoverGradient-prop">
<db:title>bgCoverGradient : StateGradient</db:title>
<db:para>各狀態背景漸層設定。</db:para>
</db:section>
<db:section xml:id="currentIndexes-prop">
<db:title>[read-only] currentIndexes : var</db:title>
<db:para>目前已選取的 index 陣列。</db:para>
</db:section>
<db:section xml:id="currentIndexesUnited-prop">
<db:title>currentIndexesUnited : string</db:title>
<db:para>目前選擇的 index 集合（以 &quot;,&quot; 串接）。</db:para>
<db:para>使用 string 組合，減少 changed 觸發的頻率。</db:para>
</db:section>
<db:section xml:id="currentValues-prop">
<db:title>[read-only] currentValues : var</db:title>
<db:para>目前已選取的 value 陣列。</db:para>
</db:section>
<db:section xml:id="defaultExpanded-prop">
<db:title>defaultExpanded : bool</db:title>
<db:para>分組預設展開狀態。</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>true → 展開</db:para>
</db:listitem>
<db:listitem>
<db:para>false → 收合</db:para>
</db:listitem>
</db:itemizedlist>
</db:section>
<db:section xml:id="delegateBottom-prop">
<db:title>delegateBottom : Component</db:title>
<db:para>Bottom 模式時選項樣板。</db:para>
</db:section>
<db:section xml:id="delegateRelative-prop">
<db:title>delegateRelative : Component</db:title>
<db:para>Relative 模式時選項樣板。</db:para>
</db:section>
<db:section xml:id="descMaxLineCount-prop">
<db:title>descMaxLineCount : int</db:title>
<db:para>描述最大行數限制。</db:para>
<db:para>當 <db:link xlink:href="qml-sc-dropdownmultiple.xml#textWrapMode-prop">textWrapMode</db:link> 允許多行時，此屬性用來限制最多顯示行數。設為 0 表示不限制行數。</db:para>
</db:section>
<db:section xml:id="descRole-prop">
<db:title>descRole : string</db:title>
<db:para>描述欄位 key。用於從 model object 中取得描述文字的 key。</db:para>
<db:para>預設 &quot;desc&quot;。</db:para>
</db:section>
<db:section xml:id="descWrapMode-prop">
<db:title>descWrapMode : enumeration</db:title>
<db:para>描述換行模式。</db:para>
</db:section>
<db:section xml:id="disableBaseState-prop">
<db:title>[read-only] disableBaseState : State</db:title>
<db:para>disable 狀態基礎設定。由 disable 繼承。</db:para>
</db:section>
<db:section xml:id="disableState-prop">
<db:title>disableState : State</db:title>
<db:para>disable 狀態設定（繼承 disablebase）。</db:para>
</db:section>
<db:section xml:id="displayMode-prop">
<db:title>displayMode : enumeration</db:title>
<db:para>顯示模式。</db:para>
<db:informaltable style="generic">
<db:thead>
<db:tr>
<db:th>
<db:para>Constant</db:para>
</db:th>
<db:th>
<db:para>Description</db:para>
</db:th>
</db:tr>
</db:thead>
<db:tr valign="top">
<db:td>
<db:para><db:link xlink:href="qml-sc-dropdownmultiple.xml">DropdownMultiple</db:link>.DisplayMode.Value</db:para>
</db:td>
<db:td>
<db:para>顯示選擇選項文字</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para><db:link xlink:href="qml-sc-dropdownmultiple.xml">DropdownMultiple</db:link>.DisplayMode.Count</db:para>
</db:td>
<db:td>
<db:para>顯示選擇選項數量</db:para>
</db:td>
</db:tr>
</db:informaltable>
</db:section>
<db:section xml:id="emptyText-prop">
<db:title>emptyText : string</db:title>
<db:para>空值顯示文字。</db:para>
</db:section>
<db:section xml:id="hoverBaseState-prop">
<db:title>[read-only] hoverBaseState : State</db:title>
<db:para>hover 狀態基礎設定。由 hover 繼承。</db:para>
</db:section>
<db:section xml:id="hoverState-prop">
<db:title>hoverState : State</db:title>
<db:para>hover 狀態設定（繼承 hoverbase）。</db:para>
</db:section>
<db:section xml:id="inCombo-prop">
<db:title>inCombo : bool</db:title>
<db:para>是否為組合按鈕。</db:para>
</db:section>
<db:section xml:id="indicatorColor-prop">
<db:title>indicatorColor : StateColor</db:title>
<db:para>各狀態下拉指示器（indicator）顏色設定。</db:para>
</db:section>
<db:section xml:id="invalid-prop">
<db:title>invalid : bool</db:title>
<db:para>是否為驗證錯誤狀態。</db:para>
<db:para>預設綁定 wavalidator.error。</db:para>
</db:section>
<db:section xml:id="isArray-prop">
<db:title>[read-only] isArray : bool</db:title>
<db:para>判斷目前 model 是否為 Array 型態。</db:para>
</db:section>
<db:section xml:id="normalBaseState-prop">
<db:title>[read-only] normalBaseState : State</db:title>
<db:para>normal 狀態基礎設定。由 normal 繼承。</db:para>
</db:section>
<db:section xml:id="normalState-prop">
<db:title>normalState : State</db:title>
<db:para>normal 狀態設定（繼承 normalbase）。</db:para>
</db:section>
<db:section xml:id="optionSummary-prop">
<db:title>[read-only] optionSummary : var</db:title>
<db:para>選項彙整。</db:para>
<db:para>回傳結構： { text: 選項文字陣列, desc: 選項描述文字陣列, icon: 是否有任一選項有圖示, sectionText: 分組選項文字陣列, sectionDesc: 分組選項描述文字陣列, sectionIcon: 是否有任一分組選項有圖示, sectionFold: 是否有任一分組選項有顯示摺疊按鈕 }</db:para>
</db:section>
<db:section xml:id="popupBindingMaxAroundHeight-prop">
<db:title>popupBindingMaxAroundHeight : bool</db:title>
<db:para>是否綁定最大高度。</db:para>
</db:section>
<db:section xml:id="popupMaxAroundHeight-prop">
<db:title>popupMaxAroundHeight : real</db:title>
<db:para>popup 上下可見範圍最大高度。</db:para>
</db:section>
<db:section xml:id="popupPosition-prop">
<db:title>popupPosition : enumeration</db:title>
<db:para>popup 位置。</db:para>
</db:section>
<db:section xml:id="posFull-prop">
<db:title>[read-only] posFull : bool</db:title>
<db:para>是否為單一佔滿模式（full width combo item）。用於判斷是否需要以全寬顯示。</db:para>
<db:para>當以下條件同時成立時為 <db:code>true：</db:code></db:para>
<db:itemizedlist>
<db:listitem>
<db:para>置於組合容器中（<db:link xlink:href="">inCombo）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>元件可見（<db:code>visible）</db:code></db:para>
</db:listitem>
<db:listitem>
<db:para>組合容器 的 visibleCount 為 1</db:para>
</db:listitem>
</db:itemizedlist>
</db:section>
<db:section xml:id="posLeft-prop">
<db:title>[read-only] posLeft : bool</db:title>
<db:para>是否位於組合元件的左側位置。</db:para>
</db:section>
<db:section xml:id="posRight-prop">
<db:title>[read-only] posRight : bool</db:title>
<db:para>是否位於組合元件的右側位置。</db:para>
</db:section>
<db:section xml:id="position-prop">
<db:title>position : enumeration</db:title>
<db:para>位於組合按鈕中的位置。</db:para>
<db:para>預設 Define.ComboPosition.Center。</db:para>
<db:informaltable style="generic">
<db:thead>
<db:tr>
<db:th>
<db:para>Constant</db:para>
</db:th>
<db:th>
<db:para>Description</db:para>
</db:th>
</db:tr>
</db:thead>
<db:tr valign="top">
<db:td>
<db:para>Define.ComboPosition.Left</db:para>
</db:td>
<db:td>
<db:para>左側。</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>Define.ComboPosition.Center</db:para>
</db:td>
<db:td>
<db:para>中間。</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>Define.ComboPosition.Right</db:para>
</db:td>
<db:td>
<db:para>右側。</db:para>
</db:td>
</db:tr>
</db:informaltable>
</db:section>
<db:section xml:id="radius-prop">
<db:title>radius : real</db:title>
<db:para>圓角半徑。</db:para>
<db:para>預設 4。</db:para>
</db:section>
<db:section xml:id="sectionRole-prop">
<db:title>sectionRole : string</db:title>
<db:para>分組欄位 key，用於從 model object 中取得分組文字的 key。</db:para>
</db:section>
<db:section xml:id="selectAllText-prop">
<db:title>selectAllText : string</db:title>
<db:para>全選選項顯示文字。</db:para>
</db:section>
<db:section xml:id="selectedStatus-prop">
<db:title>[read-only] selectedStatus : var</db:title>
<db:para>選取狀態統計資訊（含全選 / 部分選取 / 分組統計）。</db:para>
<db:para>回傳結構：</db:para>
<db:programlisting language="cpp">{
    any: 是否有任一選取,
    all: 是否全部選取,
    count: 已選數量,
    total: 總項目數,
    sections: 分組統計（若 useSection = true）
}
</db:programlisting>
</db:section>
<db:section xml:id="showSelectAll-prop">
<db:title>showSelectAll : bool</db:title>
<db:para>是否顯示全選選項。</db:para>
</db:section>
<db:section xml:id="showTitle-prop">
<db:title>showTitle : bool</db:title>
<db:para>是否顯示標題。</db:para>
</db:section>
<db:section xml:id="sizeType-prop">
<db:title>sizeType : enumeration</db:title>
<db:para>尺寸類型，控制顯示的大小。</db:para>
<db:para>預設會從父元件繼承，若未提供則依據 Global.mobile 決定：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>true → Define.SizeType.Small</db:para>
</db:listitem>
<db:listitem>
<db:para>false → Define.SizeType.Medium</db:para>
</db:listitem>
</db:itemizedlist>
<db:informaltable style="generic">
<db:thead>
<db:tr>
<db:th>
<db:para>Constant</db:para>
</db:th>
<db:th>
<db:para>Description</db:para>
</db:th>
</db:tr>
</db:thead>
<db:tr valign="top">
<db:td>
<db:para>Define.SizeType.Small</db:para>
</db:td>
<db:td>
<db:para>小尺寸</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>Define.SizeType.Medium</db:para>
</db:td>
<db:td>
<db:para>中尺寸</db:para>
</db:td>
</db:tr>
</db:informaltable>
</db:section>
<db:section xml:id="textColor-prop">
<db:title>textColor : StateColor</db:title>
<db:para>各狀態內容文字顏色設定。</db:para>
</db:section>
<db:section xml:id="textMaxLineCount-prop">
<db:title>textMaxLineCount : int</db:title>
<db:para>文字最大行數限制。</db:para>
<db:para>當 <db:link xlink:href="qml-sc-dropdownmultiple.xml#textWrapMode-prop">textWrapMode</db:link> 允許多行時，此屬性用來限制最多顯示行數。設為 0 表示不限制行數。</db:para>
</db:section>
<db:section xml:id="textMaxWidth-prop">
<db:title>[read-only] textMaxWidth : real</db:title>
<db:para>最大內容文字寬度。</db:para>
</db:section>
<db:section xml:id="textWrapMode-prop">
<db:title>textWrapMode : enumeration</db:title>
<db:para>文字換行模式。</db:para>
</db:section>
<db:section xml:id="themeName-prop">
<db:title>themeName : string</db:title>
<db:para>主題名稱。</db:para>
<db:para>預設會從父元件繼承，若未提供則使用 WATheme.systemThemeName。</db:para>
</db:section>
<db:section xml:id="themeStyle-prop">
<db:title>[read-only] themeStyle : var</db:title>
<db:para>主題樣式設定物件。</db:para>
<db:para>此屬性為唯讀，透過 <db:link xlink:href="qml-sc-dropdownmultiple.xml#getThemeStyle-method">getThemeStyle</db:link>() 動態產生。</db:para>
</db:section>
<db:section xml:id="title-prop">
<db:title>title : string</db:title>
<db:para>標題文字。</db:para>
</db:section>
<db:section xml:id="titleColor-prop">
<db:title>titleColor : StateColor</db:title>
<db:para>各狀態標題文字顏色設定。</db:para>
</db:section>
<db:section xml:id="titleImplicitWidth-prop">
<db:title>[read-only] titleImplicitWidth : real</db:title>
<db:para>標題 implicitWidth。</db:para>
</db:section>
<db:section xml:id="useSection-prop">
<db:title>useSection : bool</db:title>
<db:para>是否啟用分組。</db:para>
<db:para>啟用 ListView 依 <db:link xlink:href="qml-sc-dropdownmultiple.xml#sectionRole-prop">sectionRole</db:link> 分組</db:para>
</db:section>
<db:section xml:id="wavalidator-prop">
<db:title>wavalidator : Validator</db:title>
<db:para>欄位驗證器，包含錯誤訊息、必填。</db:para>
<db:para>使用驗證時，請在 signal validated(var val) 觸發後，再確認驗證結果 -&gt; valueChanged 事件發生較晚。</db:para>
</db:section>
</db:section>
<db:section xml:id="method-documentation">
<db:title>Method Documentation</db:title>
<db:section xml:id="getModelCount-method">
<db:title>int getModelCount()</db:title>
<db:para>取得 model 數量。</db:para>
</db:section>
<db:section xml:id="getThemeStyle-method">
<db:title>object getThemeStyle()</db:title>
<db:para>取得主題樣式設定物件。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>return</db:code></db:emphasis>主題樣式設定物件。</db:para>
</db:section>
<db:section xml:id="i18nDesc-method">
<db:title>string i18nDesc(object <db:emphasis>opt</db:emphasis>)</db:title>
<db:para>取得描述文字（<db:link xlink:href="qml-sc-dropdownmultiple.xml#descRole-prop">descRole</db:link>）。</db:para>
<db:para>可覆寫。</db:para>
</db:section>
<db:section xml:id="i18nSectionDesc-method">
<db:title>string i18nSectionDesc(string <db:emphasis>section</db:emphasis>)</db:title>
<db:para>取得分組描述文字。</db:para>
<db:para>可覆寫。</db:para>
</db:section>
<db:section xml:id="i18nSectionText-method">
<db:title>string i18nSectionText(string <db:emphasis>section</db:emphasis>)</db:title>
<db:para>取得分組顯示文字。</db:para>
<db:para>可覆寫。</db:para>
</db:section>
<db:section xml:id="i18nText-method">
<db:title>string i18nText(object <db:emphasis>opt</db:emphasis>)</db:title>
<db:para>取得顯示文字（優先 textRole，其次 valueRole）。</db:para>
<db:para>可覆寫。</db:para>
</db:section>
<db:section xml:id="optionIconSource-method">
<db:title>string optionIconSource(object <db:emphasis>opt</db:emphasis>)</db:title>
<db:para>取得圖示 source（支援 string URL）。</db:para>
<db:para>可覆寫。</db:para>
</db:section>
<db:section xml:id="optionIconText-method">
<db:title>string optionIconText(object <db:emphasis>opt</db:emphasis>)</db:title>
<db:para>取得圖示文字。</db:para>
<db:para>可覆寫。</db:para>
</db:section>
<db:section xml:id="sectionIconSource-method">
<db:title>string sectionIconSource(string <db:emphasis>section</db:emphasis>)</db:title>
<db:para>取得分組圖示 source（支援 string URL）。</db:para>
<db:para>可覆寫。</db:para>
</db:section>
<db:section xml:id="sectionShowFold-method">
<db:title>bool sectionShowFold(string <db:emphasis>section</db:emphasis>)</db:title>
<db:para>是否顯示該分組的展開/收合控制。</db:para>
<db:para>可覆寫。</db:para>
</db:section>
</db:section>
</db:article>
