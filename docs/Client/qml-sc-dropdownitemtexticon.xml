<?xml version="1.0" encoding="UTF-8"?>
<db:article xmlns:db="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.2" xml:lang="en">
<db:info>
<db:title>DropdownItemTextIcon QML Type</db:title>
<db:productname>EdgeView</db:productname>
<db:titleabbrev>EdgeView</db:titleabbrev>
<db:abstract>
<db:para>下拉圖示文字選項元件。.</db:para>
<db:para>This type was introduced in Qt 6.8.</db:para>
</db:abstract>
</db:info>
<db:variablelist>
<db:varlistentry>
<db:term>Import Statement</db:term>
<db:listitem>
<db:para>import SC</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Since:</db:term>
<db:listitem>
<db:para>Qt 6.8</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Inherits:</db:term>
<db:listitem>
<db:para><db:link xlink:href="qml-sc-dropdownitembase.xml">DropdownItemBase</db:link></db:para>
</db:listitem>
</db:varlistentry>
</db:variablelist>
<db:section xml:id="details">
<db:title>Detailed Description</db:title>
<db:para>是 <db:link xlink:href="qml-sc-dropdownitembase.xml">DropdownItemBase</db:link> 的實作元件。</db:para>
<db:para>支援功能：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>主題樣式控制（<db:link xlink:href="">themeName）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>文字顯示（<db:link xlink:href="">text</db:link>, <db:link xlink:href="">description）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>圖示顯示（<db:link xlink:href="">iconSourceUrl）</db:link></db:para>
</db:listitem>
</db:itemizedlist>
</db:section>
<db:section xml:id="property-documentation">
<db:title>Property Documentation</db:title>
<db:section xml:id="description-prop">
<db:title>description : string</db:title>
<db:para>描述文字。</db:para>
</db:section>
<db:section xml:id="descriptionColor-prop">
<db:title>descriptionColor : StateColor</db:title>
<db:para>各狀態描述文字顏色設定。</db:para>
</db:section>
<db:section xml:id="descriptionElide-prop">
<db:title>descriptionElide : enumeration</db:title>
<db:para>描述文字省略模式。</db:para>
</db:section>
<db:section xml:id="descriptionFont-prop">
<db:title>descriptionFont : font</db:title>
<db:para>描述文字字型。</db:para>
</db:section>
<db:section xml:id="descriptionLineHeight-prop">
<db:title>descriptionLineHeight : real</db:title>
<db:para>描述文字行高。</db:para>
</db:section>
<db:section xml:id="descriptionMaxLineCount-prop">
<db:title>descriptionMaxLineCount : int</db:title>
<db:para>描述文字最大行數限制。</db:para>
<db:para>當 <db:link xlink:href="qml-sc-dropdownitemtexticon.xml#textWrapMode-prop">textWrapMode</db:link> 允許多行時，此屬性用來限制最多顯示行數。設為 0 表示不限制行數。</db:para>
</db:section>
<db:section xml:id="descriptionWrapMode-prop">
<db:title>descriptionWrapMode : enumeration</db:title>
<db:para>描述文字換行模式。</db:para>
</db:section>
<db:section xml:id="iconColor-prop">
<db:title>iconColor : StateColor</db:title>
<db:para>各狀態圖示顏色設定。</db:para>
</db:section>
<db:section xml:id="iconMargin-prop">
<db:title>iconMargin : real</db:title>
<db:para>圖示邊距。</db:para>
</db:section>
<db:section xml:id="iconSize-prop">
<db:title>iconSize : real</db:title>
<db:para>圖示大小。</db:para>
</db:section>
<db:section xml:id="iconSourceUrl-prop">
<db:title>iconSourceUrl : url</db:title>
<db:para>圖示來源 URL。</db:para>
<db:para>詳細格式與限制請參考 Qt 官方文件。</db:para>
<db:para>暫時使用 string 型別。</db:para>
</db:section>
<db:section xml:id="iconText-prop">
<db:title>iconText : string</db:title>
<db:para>圖示文字內容。</db:para>
</db:section>
<db:section xml:id="showDescription-prop">
<db:title>showDescription : bool</db:title>
<db:para>是否顯示描述。</db:para>
</db:section>
<db:section xml:id="showIcon-prop">
<db:title>showIcon : bool</db:title>
<db:para>是否顯示圖示。</db:para>
</db:section>
<db:section xml:id="textColor-prop">
<db:title>textColor : StateColor</db:title>
<db:para>各狀態文字顏色設定。</db:para>
</db:section>
<db:section xml:id="textElide-prop">
<db:title>textElide : enumeration</db:title>
<db:para>文字省略模式。</db:para>
</db:section>
<db:section xml:id="textFont-prop">
<db:title>textFont : font</db:title>
<db:para>文字字型。</db:para>
</db:section>
<db:section xml:id="textLineHeight-prop">
<db:title>textLineHeight : real</db:title>
<db:para>文字行高。</db:para>
</db:section>
<db:section xml:id="textMaxLineCount-prop">
<db:title>textMaxLineCount : int</db:title>
<db:para>文字最大行數限制。</db:para>
<db:para>當 <db:link xlink:href="qml-sc-dropdownitemtexticon.xml#textWrapMode-prop">textWrapMode</db:link> 允許多行時，此屬性用來限制最多顯示行數。設為 0 表示不限制行數。</db:para>
</db:section>
<db:section xml:id="textWrapMode-prop">
<db:title>textWrapMode : enumeration</db:title>
<db:para>文字換行模式。</db:para>
</db:section>
</db:section>
</db:article>
