<?xml version="1.0" encoding="UTF-8"?>
<db:article xmlns:db="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.2" xml:lang="en">
<db:info>
<db:title>Subtitle QML Type</db:title>
<db:productname>EdgeView</db:productname>
<db:titleabbrev>EdgeView</db:titleabbrev>
<db:abstract>
<db:para>行動版副標題與描述元件。.</db:para>
<db:para>This type was introduced in Qt 6.8.</db:para>
</db:abstract>
</db:info>
<db:variablelist>
<db:varlistentry>
<db:term>Import Statement</db:term>
<db:listitem>
<db:para>import SC</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Since:</db:term>
<db:listitem>
<db:para>Qt 6.8</db:para>
</db:listitem>
</db:varlistentry>
</db:variablelist>
<db:section xml:id="details">
<db:title>Detailed Description</db:title>
<db:para>支援功能：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>系統主題切換（<db:link xlink:href="">systemThemeName）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>文字排版控制（elide/wrap/line count）</db:para>
</db:listitem>
</db:itemizedlist>
</db:section>
<db:section xml:id="property-documentation">
<db:title>Property Documentation</db:title>
<db:section xml:id="availableWidth-prop">
<db:title>[read-only] availableWidth : real</db:title>
<db:para>可用顯示寬度（扣除 leftPadding 與 rightPadding）。</db:para>
</db:section>
<db:section xml:id="description-prop">
<db:title>description : string</db:title>
<db:para>描述文字。</db:para>
</db:section>
<db:section xml:id="descriptionElide-prop">
<db:title>descriptionElide : enumeration</db:title>
<db:para>描述文字省略模式。</db:para>
</db:section>
<db:section xml:id="descriptionMaximumLineCount-prop">
<db:title>descriptionMaximumLineCount : int</db:title>
<db:para>描述文字最大行數限制。</db:para>
<db:para>當 <db:link xlink:href="qml-sc-subtitle.xml#textWrapMode-prop">textWrapMode</db:link> 允許多行時，此屬性用來限制最多顯示行數。設為 0 表示不限制行數。</db:para>
</db:section>
<db:section xml:id="descriptionWrapMode-prop">
<db:title>descriptionWrapMode : enumeration</db:title>
<db:para>描述文字換行模式。</db:para>
</db:section>
<db:section xml:id="text-prop">
<db:title>text : string</db:title>
<db:para>副標題文字。</db:para>
</db:section>
<db:section xml:id="textElide-prop">
<db:title>textElide : enumeration</db:title>
<db:para>副標題文字省略模式。</db:para>
</db:section>
<db:section xml:id="textMaximumLineCount-prop">
<db:title>textMaximumLineCount : int</db:title>
<db:para>副標題文字最大行數限制。</db:para>
<db:para>當 <db:link xlink:href="qml-sc-subtitle.xml#textWrapMode-prop">textWrapMode</db:link> 允許多行時，此屬性用來限制最多顯示行數。設為 0 表示不限制行數。</db:para>
</db:section>
<db:section xml:id="textWrapMode-prop">
<db:title>textWrapMode : enumeration</db:title>
<db:para>副標題文字換行模式。</db:para>
</db:section>
<db:section xml:id="themeName-prop">
<db:title>themeName : string</db:title>
<db:para>主題名稱。</db:para>
<db:para>預設會從父元件繼承，若未提供則使用 WATheme.systemThemeName。</db:para>
</db:section>
<db:section xml:id="themeStyle-prop">
<db:title>[read-only] themeStyle : var</db:title>
<db:para>主題樣式設定物件。</db:para>
<db:para>此屬性為唯讀，透過 <db:link xlink:href="qml-sc-subtitle.xml#getThemeStyle-method">getThemeStyle</db:link>() 動態產生。</db:para>
</db:section>
</db:section>
<db:section xml:id="method-documentation">
<db:title>Method Documentation</db:title>
<db:section xml:id="getThemeStyle-method">
<db:title>object getThemeStyle()</db:title>
<db:para>取得主題樣式設定物件。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>return</db:code></db:emphasis>主題樣式設定物件。</db:para>
</db:section>
</db:section>
</db:article>
