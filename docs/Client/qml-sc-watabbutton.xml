<?xml version="1.0" encoding="UTF-8"?>
<db:article xmlns:db="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.2" xml:lang="en">
<db:info>
<db:title>WATabButton QML Type</db:title>
<db:productname>EdgeView</db:productname>
<db:titleabbrev>EdgeView</db:titleabbrev>
<db:abstract>
<db:para>頁籤按鈕元件。.</db:para>
<db:para>This type was introduced in Qt 6.8.</db:para>
</db:abstract>
</db:info>
<db:variablelist>
<db:varlistentry>
<db:term>Import Statement</db:term>
<db:listitem>
<db:para>import SC</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Since:</db:term>
<db:listitem>
<db:para>Qt 6.8</db:para>
</db:listitem>
</db:varlistentry>
</db:variablelist>
<db:section xml:id="details">
<db:title>Detailed Description</db:title>
<db:para><db:link xlink:href="qml-sc-watabbar1.xml">WATabBar1</db:link> 搭配使用，與 <db:link xlink:href="qml-sc-watabbar1.xml">WATabBar1</db:link> 的模式與樣式設定自動同步。</db:para>
<db:para>支援功能：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>主題樣式控制（<db:link xlink:href="">themeName）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>多尺寸顯示（<db:link xlink:href="">sizeType）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>風格與模式顯示（<db:link xlink:href="qml-sc-watabbutton.xml#mode-prop">mode</db:link>, <db:link xlink:href="">style）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>文字顯示（<db:link xlink:href="qml-sc-watabbutton.xml#showText-prop">showText</db:link>, text）</db:para>
</db:listitem>
<db:listitem>
<db:para>圖示顯示（<db:link xlink:href="qml-sc-watabbutton.xml#showIcon-prop">showIcon</db:link>, <db:link xlink:href="">iconSourceUrl）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>數量標籤顯示（<db:link xlink:href="qml-sc-watabbutton.xml#showCount-prop">showCount</db:link>, <db:link xlink:href="">count）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>關閉按鈕（<db:link xlink:href="qml-sc-watabbutton.xml#showClose-prop">showClose</db:link>, <db:link xlink:href="">removeClicked）</db:link></db:para>
</db:listitem>
</db:itemizedlist>
<db:para>元件內建互動狀態：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>normal</db:para>
</db:listitem>
<db:listitem>
<db:para>hover</db:para>
</db:listitem>
<db:listitem>
<db:para>active</db:para>
</db:listitem>
<db:listitem>
<db:para>disable</db:para>
</db:listitem>
</db:itemizedlist>
<db:para>各狀態會繼承對應的 base state（例如 normal → normalbase）， 並透過 <db:link xlink:href="qml-sc-watabbutton.xml#themeStyle-prop">themeStyle</db:link> 套用背景、邊框與內容顏色等。</db:para>
</db:section>
<db:section xml:id="property-documentation">
<db:title>Property Documentation</db:title>
<db:section xml:id="activeBaseState-prop">
<db:title>[read-only] activeBaseState : State</db:title>
<db:para>active 狀態基礎設定。由 active 繼承。</db:para>
</db:section>
<db:section xml:id="activeState-prop">
<db:title>activeState : State</db:title>
<db:para>active 狀態設定（繼承 activebase）。</db:para>
</db:section>
<db:section xml:id="actived-prop">
<db:title>actived : bool</db:title>
<db:para>是否為 active。</db:para>
<db:para>預設綁定 pressed。</db:para>
</db:section>
<db:section xml:id="bdColor-prop">
<db:title>bdColor : StateColor</db:title>
<db:para>各狀態邊框顏色設定。</db:para>
</db:section>
<db:section xml:id="bgColor-prop">
<db:title>bgColor : StateColor</db:title>
<db:para>各狀態背景顏色設定。</db:para>
</db:section>
<db:section xml:id="count-prop">
<db:title>count : real</db:title>
<db:para>顯示數量。</db:para>
</db:section>
<db:section xml:id="countColorType-prop">
<db:title>countColorType : int</db:title>
<db:para>數量標籤顏色類型。</db:para>
</db:section>
<db:section xml:id="disableBaseState-prop">
<db:title>[read-only] disableBaseState : State</db:title>
<db:para>disable 狀態基礎設定。由 disable 繼承。</db:para>
</db:section>
<db:section xml:id="disableState-prop">
<db:title>disableState : State</db:title>
<db:para>disable 狀態設定（繼承 disablebase）。</db:para>
</db:section>
<db:section xml:id="hoverBaseState-prop">
<db:title>[read-only] hoverBaseState : State</db:title>
<db:para>hover 狀態基礎設定。由 hover 繼承。</db:para>
</db:section>
<db:section xml:id="hoverState-prop">
<db:title>hoverState : State</db:title>
<db:para>hover 狀態設定（繼承 hoverbase）。</db:para>
</db:section>
<db:section xml:id="iconColor-prop">
<db:title>iconColor : StateColor</db:title>
<db:para>各狀態圖示顏色設定。</db:para>
</db:section>
<db:section xml:id="iconSourceUrl-prop">
<db:title>iconSourceUrl : url</db:title>
<db:para>圖示來源 URL。</db:para>
<db:para>詳細格式與限制請參考 Qt 官方文件。</db:para>
</db:section>
<db:section xml:id="isSideBar-prop">
<db:title>[read-only] isSideBar : bool</db:title>
<db:para>是否為 Side bar 模式。</db:para>
</db:section>
<db:section xml:id="isText-prop">
<db:title>[read-only] isText : bool</db:title>
<db:para>是否為文字樣式。</db:para>
</db:section>
<db:section xml:id="lineHeight-prop">
<db:title>lineHeight : real</db:title>
<db:para>文字行高。</db:para>
</db:section>
<db:section xml:id="mode-prop">
<db:title>mode : int</db:title>
<db:para>顯示模式。</db:para>
<db:para>預設會從父元件繼承，若未提供則使用 0。</db:para>
<db:informaltable style="generic">
<db:thead>
<db:tr>
<db:th>
<db:para>Constant</db:para>
</db:th>
<db:th>
<db:para>Description</db:para>
</db:th>
</db:tr>
</db:thead>
<db:tr valign="top">
<db:td>
<db:para>0</db:para>
</db:td>
<db:td>
<db:para>Main</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>1</db:para>
</db:td>
<db:td>
<db:para>Side bar</db:para>
</db:td>
</db:tr>
</db:informaltable>
</db:section>
<db:section xml:id="normalBaseState-prop">
<db:title>[read-only] normalBaseState : State</db:title>
<db:para>normal 狀態基礎設定。由 normal 繼承。</db:para>
</db:section>
<db:section xml:id="normalState-prop">
<db:title>normalState : State</db:title>
<db:para>normal 狀態設定（繼承 normalbase）。</db:para>
</db:section>
<db:section xml:id="radius-prop">
<db:title>radius : real</db:title>
<db:para>按鈕圓角半徑。</db:para>
<db:para>預設 8。</db:para>
</db:section>
<db:section xml:id="showClose-prop">
<db:title>showClose : bool</db:title>
<db:para>是否顯示關閉按鈕。</db:para>
</db:section>
<db:section xml:id="showCount-prop">
<db:title>showCount : bool</db:title>
<db:para>是否顯示數量標籤。</db:para>
</db:section>
<db:section xml:id="showIcon-prop">
<db:title>showIcon : bool</db:title>
<db:para>是否顯示圖示。</db:para>
</db:section>
<db:section xml:id="showText-prop">
<db:title>showText : bool</db:title>
<db:para>是否顯示文字。</db:para>
</db:section>
<db:section xml:id="sizeType-prop">
<db:title>sizeType : enumeration</db:title>
<db:para>尺寸類型，控制顯示的大小。</db:para>
<db:para>預設會從父元件繼承，若未提供則依據 Global.mobile 決定：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>true → Define.SizeType.Small</db:para>
</db:listitem>
<db:listitem>
<db:para>false → Define.SizeType.Medium</db:para>
</db:listitem>
</db:itemizedlist>
<db:informaltable style="generic">
<db:thead>
<db:tr>
<db:th>
<db:para>Constant</db:para>
</db:th>
<db:th>
<db:para>Description</db:para>
</db:th>
</db:tr>
</db:thead>
<db:tr valign="top">
<db:td>
<db:para>Define.SizeType.Small</db:para>
</db:td>
<db:td>
<db:para>小尺寸</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>Define.SizeType.Medium</db:para>
</db:td>
<db:td>
<db:para>中尺寸</db:para>
</db:td>
</db:tr>
</db:informaltable>
</db:section>
<db:section xml:id="style-prop">
<db:title>style : int</db:title>
<db:para>顯示樣式</db:para>
<db:para>預設會從父元件繼承，若未提供則使用 Define.ButtonStyle.Filled。</db:para>
<db:informaltable style="generic">
<db:thead>
<db:tr>
<db:th>
<db:para>Constant</db:para>
</db:th>
<db:th>
<db:para>Description</db:para>
</db:th>
</db:tr>
</db:thead>
<db:tr valign="top">
<db:td>
<db:para>Define.ButtonStyle.Filled</db:para>
</db:td>
<db:td>
<db:para>填充樣式。</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>Define.ButtonStyle.Text</db:para>
</db:td>
<db:td>
<db:para>純文字樣式。</db:para>
</db:td>
</db:tr>
</db:informaltable>
</db:section>
<db:section xml:id="textColor-prop">
<db:title>textColor : StateColor</db:title>
<db:para>各狀態文字顏色設定。</db:para>
</db:section>
<db:section xml:id="themeName-prop">
<db:title>themeName : string</db:title>
<db:para>主題名稱。</db:para>
<db:para>預設會從父元件繼承，若未提供則使用 WATheme.systemThemeName。</db:para>
</db:section>
<db:section xml:id="themeStyle-prop">
<db:title>[read-only] themeStyle : var</db:title>
<db:para>主題樣式設定物件。</db:para>
<db:para>此屬性為唯讀，透過 <db:link xlink:href="qml-sc-watabbutton.xml#getThemeStyle-method">getThemeStyle</db:link>() 動態產生。</db:para>
</db:section>
</db:section>
<db:section xml:id="signal-documentation">
<db:title>Signal Documentation</db:title>
<db:section xml:id="removeClicked-signal">
<db:title>removeClicked()</db:title>
<db:para>點擊關閉按鈕時觸發。</db:para>
<db:note>
<db:para>The corresponding handler is <db:code>onRemoveClicked</db:code>.</db:para>
</db:note>
</db:section>
</db:section>
<db:section xml:id="method-documentation">
<db:title>Method Documentation</db:title>
<db:section xml:id="getThemeStyle-method">
<db:title>object getThemeStyle()</db:title>
<db:para>取得主題樣式設定物件。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>return</db:code></db:emphasis>主題樣式設定物件。</db:para>
</db:section>
</db:section>
</db:article>
