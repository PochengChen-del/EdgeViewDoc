<?xml version="1.0" encoding="UTF-8"?>
<db:article xmlns:db="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.2" xml:lang="en">
<db:info>
<db:title>RecentList QML Type</db:title>
<db:productname>EdgeView</db:productname>
<db:titleabbrev>EdgeView</db:titleabbrev>
<db:abstract>
<db:para>行動版最近搜尋紀錄清單元件。.</db:para>
<db:para>This type was introduced in Qt 6.8.</db:para>
</db:abstract>
</db:info>
<db:variablelist>
<db:varlistentry>
<db:term>Import Statement</db:term>
<db:listitem>
<db:para>import SC</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Since:</db:term>
<db:listitem>
<db:para>Qt 6.8</db:para>
</db:listitem>
</db:varlistentry>
</db:variablelist>
<db:section xml:id="details">
<db:title>Detailed Description</db:title>
<db:para>支援功能：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>系統主題切換（<db:link xlink:href="">systemThemeName）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>紀錄處理（<db:link xlink:href="qml-sc-recentlist.xml#recentKey-prop">recentKey</db:link>, <db:link xlink:href="">maxRecent）</db:link></db:para>
<db:itemizedlist>
<db:listitem>
<db:para>本機快取儲存（wacache）</db:para>
</db:listitem>
<db:listitem>
<db:para>紀錄新增/刪除/清除</db:para>
</db:listitem>
<db:listitem>
<db:para>最大筆數限制</db:para>
</db:listitem>
</db:itemizedlist>
</db:listitem>
<db:listitem>
<db:para>點擊選取事件</db:para>
</db:listitem>
</db:itemizedlist>
</db:section>
<db:section xml:id="property-documentation">
<db:title>Property Documentation</db:title>
<db:section xml:id="bottomPadding-prop">
<db:title>bottomPadding : real</db:title>
<db:para>下方邊距。</db:para>
</db:section>
<db:section xml:id="cacheGroupName-prop">
<db:title>[read-only] cacheGroupName : string</db:title>
<db:para>快取分組名稱。</db:para>
<db:para>依據環境（host）動態產生，用於區分不同後端環境的資料。</db:para>
</db:section>
<db:section xml:id="leftPadding-prop">
<db:title>leftPadding : real</db:title>
<db:para>左方邊距。</db:para>
</db:section>
<db:section xml:id="maxRecent-prop">
<db:title>maxRecent : int</db:title>
<db:para>最近紀錄的最大保留數量。</db:para>
<db:para>預設 5。</db:para>
</db:section>
<db:section xml:id="recentKey-prop">
<db:title>recentKey : string</db:title>
<db:para>最近紀錄分類的 key，區分不同搜尋紀錄。</db:para>
</db:section>
<db:section xml:id="rightPadding-prop">
<db:title>rightPadding : real</db:title>
<db:para>右方邊距。</db:para>
</db:section>
<db:section xml:id="themeName-prop">
<db:title>themeName : string</db:title>
<db:para>主題名稱。</db:para>
<db:para>預設會從父元件繼承，若未提供則使用 WATheme.systemThemeName。</db:para>
</db:section>
<db:section xml:id="themeStyle-prop">
<db:title>[read-only] themeStyle : var</db:title>
<db:para>主題樣式設定物件。</db:para>
<db:para>此屬性為唯讀，透過 <db:link xlink:href="qml-sc-recentlist.xml#getThemeStyle-method">getThemeStyle</db:link>() 動態產生。</db:para>
</db:section>
</db:section>
<db:section xml:id="signal-documentation">
<db:title>Signal Documentation</db:title>
<db:section xml:id="recentSelected-signal">
<db:title>recentSelected(string <db:emphasis>recentText</db:emphasis>)</db:title>
<db:para>點擊最近紀錄時觸發。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>param</db:code></db:emphasis>recentText 被選取的搜尋文字</db:para>
<db:note>
<db:para>The corresponding handler is <db:code>onRecentSelected</db:code>.</db:para>
</db:note>
</db:section>
</db:section>
<db:section xml:id="method-documentation">
<db:title>Method Documentation</db:title>
<db:section xml:id="addRecent-method">
<db:title>void addRecent(string <db:emphasis>recentText</db:emphasis>)</db:title>
<db:para>新增一筆最近紀錄。</db:para>
<db:para>若已存在相同文字會自動移到最前面。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>param</db:code></db:emphasis>recentText 新增文字</db:para>
</db:section>
<db:section xml:id="clearRecent-method">
<db:title>void clearRecent()</db:title>
<db:para>清除所有最近紀錄。</db:para>
</db:section>
<db:section xml:id="getRecents-method">
<db:title>string[] getRecents()</db:title>
<db:para>取得最近紀錄清單。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>return</db:code></db:emphasis>string[]</db:para>
</db:section>
<db:section xml:id="getThemeStyle-method">
<db:title>object getThemeStyle()</db:title>
<db:para>取得主題樣式設定物件。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>return</db:code></db:emphasis>主題樣式設定物件。</db:para>
</db:section>
<db:section xml:id="removeRecent-method">
<db:title>void removeRecent(string <db:emphasis>recentText</db:emphasis>)</db:title>
<db:para>移除單筆最近紀錄。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>param</db:code></db:emphasis>recentText 刪除文字</db:para>
</db:section>
</db:section>
</db:article>
