<?xml version="1.0" encoding="UTF-8"?>
<db:article xmlns:db="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.2" xml:lang="en">
<db:info>
<db:title>ColorPicker QML Type</db:title>
<db:productname>EdgeView</db:productname>
<db:titleabbrev>EdgeView</db:titleabbrev>
<db:abstract>
<db:para>顏色選擇器元件。.</db:para>
<db:para>This type was introduced in Qt 6.8.</db:para>
</db:abstract>
</db:info>
<db:variablelist>
<db:varlistentry>
<db:term>Import Statement</db:term>
<db:listitem>
<db:para>import SC</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Since:</db:term>
<db:listitem>
<db:para>Qt 6.8</db:para>
</db:listitem>
</db:varlistentry>
</db:variablelist>
<db:section xml:id="details">
<db:title>Detailed Description</db:title>
<db:para>元件組成：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>Sliders：顏色選擇區（HSV與透明度）</db:para>
</db:listitem>
<db:listitem>
<db:para>Inputs：輸入區（顏色（HEX/RGB）與透明度輸入）</db:para>
</db:listitem>
<db:listitem>
<db:para>Brightness：明暗調整區</db:para>
</db:listitem>
<db:listitem>
<db:para>Palette：調色盤區（系統與自訂）</db:para>
</db:listitem>
</db:itemizedlist>
<db:para>支援功能：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>主題樣式控制（<db:link xlink:href="">themeName）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>多尺寸顯示（<db:link xlink:href="">sizeType）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>顏色選取與輸入處理</db:para>
</db:listitem>
<db:listitem>
<db:para>顏色明暗處理</db:para>
</db:listitem>
<db:listitem>
<db:para>自訂調色盤管理</db:para>
</db:listitem>
</db:itemizedlist>
</db:section>
<db:section xml:id="property-documentation">
<db:title>Property Documentation</db:title>
<db:section xml:id="brightness-prop">
<db:title>brightness : real</db:title>
<db:para>亮度調整比例（0 ~ 1），控制「變亮/變暗」的強度。</db:para>
</db:section>
<db:section xml:id="cellSpacing-prop">
<db:title>cellSpacing : real</db:title>
<db:para>調色盤顏色項目間距。</db:para>
</db:section>
<db:section xml:id="chipColumns-prop">
<db:title>chipColumns : int</db:title>
<db:para>調色盤顏色顯示欄數。</db:para>
</db:section>
<db:section xml:id="color-prop">
<db:title>color : color</db:title>
<db:para>目前選擇的顏色。</db:para>
</db:section>
<db:section xml:id="showBrightness-prop">
<db:title>showBrightness : bool</db:title>
<db:para>是否顯示亮度調整控制。</db:para>
</db:section>
<db:section xml:id="showInputs-prop">
<db:title>showInputs : bool</db:title>
<db:para>是否顯示 HEX / RGB 輸入區。</db:para>
</db:section>
<db:section xml:id="showPalettes-prop">
<db:title>showPalettes : bool</db:title>
<db:para>是否顯示調色盤區。</db:para>
</db:section>
<db:section xml:id="sizeType-prop">
<db:title>sizeType : enumeration</db:title>
<db:para>尺寸類型，控制顯示的大小。</db:para>
<db:para>預設會從父元件繼承，若未提供則依據 Global.mobile 決定：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>true → Define.SizeType.Small</db:para>
</db:listitem>
<db:listitem>
<db:para>false → Define.SizeType.Medium</db:para>
</db:listitem>
</db:itemizedlist>
<db:informaltable style="generic">
<db:thead>
<db:tr>
<db:th>
<db:para>Constant</db:para>
</db:th>
<db:th>
<db:para>Description</db:para>
</db:th>
</db:tr>
</db:thead>
<db:tr valign="top">
<db:td>
<db:para>Define.SizeType.Small</db:para>
</db:td>
<db:td>
<db:para>小尺寸</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>Define.SizeType.Medium</db:para>
</db:td>
<db:td>
<db:para>中尺寸</db:para>
</db:td>
</db:tr>
</db:informaltable>
</db:section>
<db:section xml:id="sliderHeight-prop">
<db:title>sliderHeight : real</db:title>
<db:para>顏色選擇區（HSV 與 Alpha）高度。</db:para>
</db:section>
<db:section xml:id="themeName-prop">
<db:title>themeName : string</db:title>
<db:para>主題名稱。</db:para>
<db:para>預設會從父元件繼承，若未提供則使用 WATheme.systemThemeName。</db:para>
</db:section>
<db:section xml:id="themeStyle-prop">
<db:title>[read-only] themeStyle : var</db:title>
<db:para>主題樣式設定物件。</db:para>
<db:para>此屬性為唯讀，透過 <db:link xlink:href="qml-sc-colorpicker.xml#getThemeStyle-method">getThemeStyle</db:link>() 動態產生。</db:para>
</db:section>
</db:section>
<db:section xml:id="method-documentation">
<db:title>Method Documentation</db:title>
<db:section xml:id="getThemeStyle-method">
<db:title>object getThemeStyle()</db:title>
<db:para>取得主題樣式設定物件。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>return</db:code></db:emphasis>主題樣式設定物件。</db:para>
</db:section>
</db:section>
</db:article>
