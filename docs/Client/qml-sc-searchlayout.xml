<?xml version="1.0" encoding="UTF-8"?>
<db:article xmlns:db="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.2" xml:lang="en">
<db:info>
<db:title>SearchLayout QML Type</db:title>
<db:productname>EdgeView</db:productname>
<db:titleabbrev>EdgeView</db:titleabbrev>
<db:abstract>
<db:para>行動版查詢版面配置容器。.</db:para>
<db:para>This type was introduced in Qt 6.8.</db:para>
</db:abstract>
</db:info>
<db:variablelist>
<db:varlistentry>
<db:term>Import Statement</db:term>
<db:listitem>
<db:para>import SC</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Since:</db:term>
<db:listitem>
<db:para>Qt 6.8</db:para>
</db:listitem>
</db:varlistentry>
</db:variablelist>
<db:section xml:id="details">
<db:title>Detailed Description</db:title>
<db:para>搜尋邏輯需由外部覆寫 <db:link xlink:href="qml-sc-searchlayout.xml#search-method">search</db:link>() 進行實作。</db:para>
<db:para>元件組成：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>Header：返回按鈕、搜尋輸入框與清除按鈕</db:para>
</db:listitem>
<db:listitem>
<db:para>Page：搜尋結果區域</db:para>
</db:listitem>
</db:itemizedlist>
<db:para>支援功能：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>主題樣式控制（<db:link xlink:href="">themeName）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>搜尋控制（<db:link xlink:href="qml-sc-searchlayout.xml#searchText-prop">searchText</db:link>, <db:link xlink:href="">search()）</db:link></db:para>
</db:listitem>
</db:itemizedlist>
<db:para>使用：</db:para>
<db:programlisting language="cpp">SearchLayout {
    anchors.fill: parent
    pageItem: Item {
        anchors.fill: parent
    }

    function search() {
        // 實作搜尋
    }
}
</db:programlisting>
</db:section>
<db:section xml:id="property-documentation">
<db:title>Property Documentation</db:title>
<db:section xml:id="backEnabled-prop">
<db:title>backEnabled : bool</db:title>
<db:para>返回按鈕是否啟用。</db:para>
</db:section>
<db:section xml:id="bottomSafeMargins-prop">
<db:title>bottomSafeMargins : real</db:title>
<db:para>下方安全邊界。</db:para>
</db:section>
<db:section xml:id="leftSafeMargins-prop">
<db:title>leftSafeMargins : real</db:title>
<db:para>左側安全邊界。</db:para>
</db:section>
<db:section xml:id="pageItem-prop">
<db:title>pageItem : Item</db:title>
<db:para>查詢頁面內容區域的子元件，用於自訂搜尋結果內容。</db:para>
</db:section>
<db:section xml:id="rightSafeMargins-prop">
<db:title>rightSafeMargins : real</db:title>
<db:para>右側安全邊界。</db:para>
</db:section>
<db:section xml:id="searchText-prop">
<db:title>searchText : string</db:title>
<db:para>查詢文字。</db:para>
</db:section>
<db:section xml:id="showBack-prop">
<db:title>showBack : bool</db:title>
<db:para>是否顯示返回按鈕。</db:para>
</db:section>
<db:section xml:id="themeName-prop">
<db:title>themeName : string</db:title>
<db:para>主題名稱。</db:para>
<db:para>預設會從父元件繼承，若未提供則使用 WATheme.systemThemeName。</db:para>
</db:section>
<db:section xml:id="themeStyle-prop">
<db:title>[read-only] themeStyle : var</db:title>
<db:para>主題樣式設定物件。</db:para>
<db:para>此屬性為唯讀，透過 <db:link xlink:href="qml-sc-searchlayout.xml#getThemeStyle-method">getThemeStyle</db:link>() 動態產生。</db:para>
</db:section>
<db:section xml:id="topSafeMargins-prop">
<db:title>topSafeMargins : real</db:title>
<db:para>上方安全邊界。</db:para>
</db:section>
</db:section>
<db:section xml:id="signal-documentation">
<db:title>Signal Documentation</db:title>
<db:section xml:id="backClicked-signal">
<db:title>backClicked()</db:title>
<db:para>點擊返回按鈕時觸發。</db:para>
<db:note>
<db:para>The corresponding handler is <db:code>onBackClicked</db:code>.</db:para>
</db:note>
</db:section>
</db:section>
<db:section xml:id="method-documentation">
<db:title>Method Documentation</db:title>
<db:section xml:id="clearSearchText-method">
<db:title>void clearSearchText()</db:title>
<db:para>清空搜尋文字，並觸發 <db:link xlink:href="qml-sc-searchlayout.xml#search-method">search</db:link>()。</db:para>
</db:section>
<db:section xml:id="focusSearchText-method">
<db:title>void focusSearchText()</db:title>
<db:para>將輸入框設為 focus。</db:para>
</db:section>
<db:section xml:id="getThemeStyle-method">
<db:title>object getThemeStyle()</db:title>
<db:para>取得主題樣式設定物件。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>return</db:code></db:emphasis>主題樣式設定物件。</db:para>
</db:section>
<db:section xml:id="search-method">
<db:title>void search()</db:title>
<db:para>執行搜尋。</db:para>
<db:para>外部覆寫實作：</db:para>
<db:programlisting language="cpp">function search()
</db:programlisting>
</db:section>
</db:section>
</db:article>
