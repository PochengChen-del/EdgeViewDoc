<?xml version="1.0" encoding="UTF-8"?>
<db:article xmlns:db="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.2" xml:lang="en">
<db:info>
<db:title>ButtonColor QML Type</db:title>
<db:productname>EdgeView</db:productname>
<db:titleabbrev>EdgeView</db:titleabbrev>
<db:abstract>
<db:para>顏色按鈕。.</db:para>
<db:para>This type was introduced in Qt 6.8.</db:para>
</db:abstract>
</db:info>
<db:variablelist>
<db:varlistentry>
<db:term>Import Statement</db:term>
<db:listitem>
<db:para>import SC</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Since:</db:term>
<db:listitem>
<db:para>Qt 6.8</db:para>
</db:listitem>
</db:varlistentry>
</db:variablelist>
<db:section xml:id="details">
<db:title>Detailed Description</db:title>
<db:para><db:link xlink:href="qml-sc-colorpicker.xml">ColorPicker</db:link> 使用。</db:para>
<db:para>支援功能：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>顏色顯示（<db:link xlink:href="">color）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>選取狀態顯示（<db:link xlink:href="">checked）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>對比處理（<db:link xlink:href="">factorMode）</db:link></db:para>
</db:listitem>
</db:itemizedlist>
</db:section>
<db:section xml:id="property-documentation">
<db:title>Property Documentation</db:title>
<db:section xml:id="actived-prop">
<db:title>actived : bool</db:title>
<db:para>是否為 active。</db:para>
<db:para>預設綁定 pressed。</db:para>
</db:section>
<db:section xml:id="color-prop">
<db:title>color : color</db:title>
<db:para>顯示的顏色。</db:para>
</db:section>
<db:section xml:id="factorAlphaValue-prop">
<db:title>[read-only] factorAlphaValue : real</db:title>
<db:para>含透明度的亮度計算結果。</db:para>
</db:section>
<db:section xml:id="factorLimit-prop">
<db:title>[read-only] factorLimit : real</db:title>
<db:para>判斷顏色是否需要對比處理的門檻值。</db:para>
</db:section>
<db:section xml:id="factorMode-prop">
<db:title>factorMode : real</db:title>
<db:para>顏色顯示處理方式。</db:para>
<db:para>預設綁定 WATheme.colorPickerStyle 的 factorMode。</db:para>
<db:informaltable style="generic">
<db:thead>
<db:tr>
<db:th>
<db:para>Constant</db:para>
</db:th>
<db:th>
<db:para>Description</db:para>
</db:th>
</db:tr>
</db:thead>
<db:tr valign="top">
<db:td>
<db:para>1</db:para>
</db:td>
<db:td>
<db:para>淺色處理。</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>0</db:para>
</db:td>
<db:td>
<db:para>不處理。</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>-1</db:para>
</db:td>
<db:td>
<db:para>深色處理。</db:para>
</db:td>
</db:tr>
</db:informaltable>
</db:section>
<db:section xml:id="factorValue-prop">
<db:title>[read-only] factorValue : real</db:title>
<db:para>顏色亮度值。</db:para>
<db:para>公式：0.299R + 0.587G + 0.114B</db:para>
</db:section>
<db:section xml:id="impacted-prop">
<db:title>[read-only] impacted : bool</db:title>
<db:para>是否觸發對比強化。</db:para>
<db:para>當顏色過亮或過暗時，會切換勾選圖示顏色。</db:para>
</db:section>
<db:section xml:id="radius-prop">
<db:title>radius : real</db:title>
<db:para>按鈕圓角半徑。</db:para>
<db:para>預設 0。</db:para>
</db:section>
<db:section xml:id="sizeType-prop">
<db:title>sizeType : enumeration</db:title>
<db:para>尺寸類型，控制顯示的大小。</db:para>
<db:para>預設會從父元件繼承，若未提供則依據 Global.mobile 決定：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>true → Define.SizeType.Small</db:para>
</db:listitem>
<db:listitem>
<db:para>false → Define.SizeType.Medium</db:para>
</db:listitem>
</db:itemizedlist>
<db:informaltable style="generic">
<db:thead>
<db:tr>
<db:th>
<db:para>Constant</db:para>
</db:th>
<db:th>
<db:para>Description</db:para>
</db:th>
</db:tr>
</db:thead>
<db:tr valign="top">
<db:td>
<db:para>Define.SizeType.Small</db:para>
</db:td>
<db:td>
<db:para>小尺寸</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>Define.SizeType.Medium</db:para>
</db:td>
<db:td>
<db:para>中尺寸</db:para>
</db:td>
</db:tr>
</db:informaltable>
</db:section>
<db:section xml:id="themeName-prop">
<db:title>themeName : string</db:title>
<db:para>主題名稱。</db:para>
<db:para>預設會從父元件繼承，若未提供則使用 WATheme.systemThemeName。</db:para>
</db:section>
<db:section xml:id="themeStyle-prop">
<db:title>[read-only] themeStyle : var</db:title>
<db:para>主題樣式設定物件。</db:para>
<db:para>此屬性為唯讀，透過 <db:link xlink:href="qml-sc-buttoncolor.xml#getThemeStyle-method">getThemeStyle</db:link>() 動態產生。</db:para>
</db:section>
</db:section>
<db:section xml:id="method-documentation">
<db:title>Method Documentation</db:title>
<db:section xml:id="getThemeStyle-method">
<db:title>object getThemeStyle()</db:title>
<db:para>取得主題樣式設定物件。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>return</db:code></db:emphasis>主題樣式設定物件。</db:para>
</db:section>
</db:section>
</db:article>
