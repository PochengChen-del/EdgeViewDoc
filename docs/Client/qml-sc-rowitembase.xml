<?xml version="1.0" encoding="UTF-8"?>
<db:article xmlns:db="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.2" xml:lang="en">
<db:info>
<db:title>RowItemBase QML Type</db:title>
<db:productname>EdgeView</db:productname>
<db:titleabbrev>EdgeView</db:titleabbrev>
<db:abstract>
<db:para>行動版單行顯示基礎元件。.</db:para>
<db:para>This type was introduced in Qt 6.8.</db:para>
</db:abstract>
</db:info>
<db:variablelist>
<db:varlistentry>
<db:term>Import Statement</db:term>
<db:listitem>
<db:para>import SC</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Since:</db:term>
<db:listitem>
<db:para>Qt 6.8</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Inherited By:</db:term>
<db:listitem>
<db:para><db:link xlink:href="qml-sc-rowitemtext.xml" xlink:role="">RowItemText</db:link>, <db:link xlink:href="qml-sc-rowitemtexticon.xml" xlink:role="">RowItemTextIcon</db:link>, and <db:link xlink:href="qml-sc-rowitemtextvalue.xml" xlink:role="">RowItemTextValue</db:link></db:para>
</db:listitem>
</db:varlistentry>
</db:variablelist>
<db:section xml:id="details">
<db:title>Detailed Description</db:title>
<db:para>是 RowItem 的基礎。</db:para>
</db:section>
<db:section xml:id="property-documentation">
<db:title>Property Documentation</db:title>
<db:section xml:id="bottomPadding-prop">
<db:title>bottomPadding : real</db:title>
<db:para>下方邊距。</db:para>
</db:section>
<db:section xml:id="divColor-prop">
<db:title>divColor : color</db:title>
<db:para>分隔線顏色。</db:para>
</db:section>
<db:section xml:id="divHorizontalAlignment-prop">
<db:title>divHorizontalAlignment : int</db:title>
<db:para>分隔線水平對齊方式。</db:para>
<db:para>預設 Qt.AlignRight。</db:para>
<db:informaltable style="generic">
<db:thead>
<db:tr>
<db:th>
<db:para>Constant</db:para>
</db:th>
<db:th>
<db:para>Description</db:para>
</db:th>
</db:tr>
</db:thead>
<db:tr valign="top">
<db:td>
<db:para>Qt.AlignLeft</db:para>
</db:td>
<db:td>
<db:para>靠左</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>Qt.AlignHCenter</db:para>
</db:td>
<db:td>
<db:para>置中</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>Qt.AlignRight</db:para>
</db:td>
<db:td>
<db:para>靠右</db:para>
</db:td>
</db:tr>
</db:informaltable>
</db:section>
<db:section xml:id="divWidth-prop">
<db:title>divWidth : real</db:title>
<db:para>分隔線寬度。</db:para>
</db:section>
<db:section xml:id="horizontalPadding-prop">
<db:title>horizontalPadding : real</db:title>
<db:para>水平邊距。</db:para>
</db:section>
<db:section xml:id="leftPadding-prop">
<db:title>leftPadding : real</db:title>
<db:para>左方邊距。</db:para>
</db:section>
<db:section xml:id="rightPadding-prop">
<db:title>rightPadding : real</db:title>
<db:para>右方邊距。</db:para>
</db:section>
<db:section xml:id="showDiv-prop">
<db:title>showDiv : bool</db:title>
<db:para>是否顯示底部分隔線。</db:para>
</db:section>
<db:section xml:id="spacing-prop">
<db:title>spacing : real</db:title>
<db:para>間距。</db:para>
</db:section>
<db:section xml:id="themeName-prop">
<db:title>themeName : string</db:title>
<db:para>主題名稱。</db:para>
<db:para>預設會從父元件繼承，若未提供則使用 WATheme.systemThemeName。</db:para>
</db:section>
<db:section xml:id="themeStyle-prop">
<db:title>[read-only] themeStyle : var</db:title>
<db:para>主題樣式設定物件。</db:para>
<db:para>此屬性為唯讀，透過 <db:link xlink:href="qml-sc-rowitembase.xml#getThemeStyle-method">getThemeStyle</db:link>() 動態產生。</db:para>
</db:section>
<db:section xml:id="topPadding-prop">
<db:title>topPadding : real</db:title>
<db:para>上方邊距。</db:para>
</db:section>
<db:section xml:id="verticalPadding-prop">
<db:title>verticalPadding : real</db:title>
<db:para>垂直邊距。</db:para>
</db:section>
</db:section>
<db:section xml:id="method-documentation">
<db:title>Method Documentation</db:title>
<db:section xml:id="getThemeStyle-method">
<db:title>object getThemeStyle()</db:title>
<db:para>取得主題樣式設定物件。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>return</db:code></db:emphasis>主題樣式設定物件。</db:para>
</db:section>
</db:section>
