<?xml version="1.0" encoding="UTF-8"?>
<db:article xmlns:db="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.2" xml:lang="en">
<db:info>
<db:title>NavigationFuncList QML Type</db:title>
<db:productname>EdgeView</db:productname>
<db:titleabbrev>EdgeView</db:titleabbrev>
<db:abstract>
<db:para>階層式導覽列表元件。.</db:para>
<db:para>This type was introduced in Qt 6.8.</db:para>
</db:abstract>
</db:info>
<db:variablelist>
<db:varlistentry>
<db:term>Import Statement</db:term>
<db:listitem>
<db:para>import SC</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Since:</db:term>
<db:listitem>
<db:para>Qt 6.8</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Inherits:</db:term>
<db:listitem>
<db:para><db:link xlink:href="qml-sc-wascrollview.xml">WAScrollView</db:link></db:para>
</db:listitem>
</db:varlistentry>
</db:variablelist>
<db:section xml:id="details">
<db:title>Detailed Description</db:title>
<db:para>支援功能：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>主題樣式控制（<db:link xlink:href="">themeName）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>多尺寸顯示（<db:link xlink:href="">sizeType）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>階層式導覽</db:para>
</db:listitem>
<db:listitem>
<db:para>非同步選取檢查（<db:link xlink:href="">checkBeforeSelectFunc）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>自訂文字與狀態邏輯</db:para>
</db:listitem>
</db:itemizedlist>
</db:section>
<db:section xml:id="property-documentation">
<db:title>Property Documentation</db:title>
<db:section xml:id="bottomSafeMargins-prop">
<db:title>bottomSafeMargins : real</db:title>
<db:para>下方安全邊距。</db:para>
</db:section>
<db:section xml:id="count-prop">
<db:title>[read-only] count : int</db:title>
<db:para>根節點數量。</db:para>
</db:section>
<db:section xml:id="currentValues-prop">
<db:title>currentValues : var</db:title>
<db:para>目前選取的導覽路徑。</db:para>
<db:para>型態為 Array。</db:para>
</db:section>
<db:section xml:id="isArray-prop">
<db:title>[read-only] isArray : bool</db:title>
<db:para>判斷目前 model 是否為 Array 型態。</db:para>
</db:section>
<db:section xml:id="leftSafeMargins-prop">
<db:title>leftSafeMargins : real</db:title>
<db:para>左側安全邊距。</db:para>
</db:section>
<db:section xml:id="model-prop">
<db:title>model : var</db:title>
<db:para>導覽資料來源。</db:para>
<db:para>每個項目需包含：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>value</db:para>
</db:listitem>
<db:listitem>
<db:para>style</db:para>
</db:listitem>
<db:listitem>
<db:para>text（選用）</db:para>
</db:listitem>
<db:listitem>
<db:para>nextNavs（選用）</db:para>
</db:listitem>
<db:listitem>
<db:para>iconSource（選用）</db:para>
</db:listitem>
</db:itemizedlist>
</db:section>
<db:section xml:id="nextNavsRole-prop">
<db:title>nextNavsRole : string</db:title>
<db:para>子導覽資料欄位名稱。</db:para>
<db:para>預設 &quot;nextNavs&quot;。</db:para>
</db:section>
<db:section xml:id="rightSafeMargins-prop">
<db:title>rightSafeMargins : real</db:title>
<db:para>右側安全邊距。</db:para>
</db:section>
<db:section xml:id="sizeType-prop">
<db:title>sizeType : enumeration</db:title>
<db:para>尺寸類型，控制顯示的大小。</db:para>
<db:para>預設會從父元件繼承，若未提供則依據 Global.mobile 決定：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>true → Define.SizeType.Small</db:para>
</db:listitem>
<db:listitem>
<db:para>false → Define.SizeType.Medium</db:para>
</db:listitem>
</db:itemizedlist>
<db:informaltable style="generic">
<db:thead>
<db:tr>
<db:th>
<db:para>Constant</db:para>
</db:th>
<db:th>
<db:para>Description</db:para>
</db:th>
</db:tr>
</db:thead>
<db:tr valign="top">
<db:td>
<db:para>Define.SizeType.Small</db:para>
</db:td>
<db:td>
<db:para>小尺寸</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>Define.SizeType.Medium</db:para>
</db:td>
<db:td>
<db:para>中尺寸</db:para>
</db:td>
</db:tr>
</db:informaltable>
</db:section>
<db:section xml:id="styleRole-prop">
<db:title>styleRole : string</db:title>
<db:para>顯示樣式欄位名稱。</db:para>
<db:para>預設 &quot;style&quot;。</db:para>
</db:section>
<db:section xml:id="textRole-prop">
<db:title>textRole : string</db:title>
<db:para>顯示文字欄位名稱。</db:para>
<db:para>預設 &quot;text&quot;。</db:para>
</db:section>
<db:section xml:id="topSafeMargins-prop">
<db:title>topSafeMargins : real</db:title>
<db:para>上方安全邊距。</db:para>
</db:section>
<db:section xml:id="valueRole-prop">
<db:title>valueRole : string</db:title>
<db:para>導覽值欄位名稱。</db:para>
<db:para>預設 &quot;value&quot;。</db:para>
</db:section>
</db:section>
<db:section xml:id="method-documentation">
<db:title>Method Documentation</db:title>
<db:section xml:id="checkBeforeSelectFunc-method">
<db:title>Promise checkBeforeSelectFunc()</db:title>
<db:para>選取前檢查函式。</db:para>
<db:para>可覆寫。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>return</db:code></db:emphasis>Promise&lt;Boolean&gt;</db:para>
</db:section>
<db:section xml:id="i18nText-method">
<db:title>string i18nText(object <db:emphasis>navData</db:emphasis>, array <db:emphasis>values</db:emphasis>)</db:title>
<db:para>取得導覽項目顯示文字（優先 <db:link xlink:href="qml-sc-navigationfunclist.xml#textRole-prop">textRole</db:link>，其次 <db:link xlink:href="qml-sc-navigationfunclist.xml#valueRole-prop">valueRole</db:link>）。</db:para>
<db:para>可覆寫。</db:para>
</db:section>
<db:section xml:id="navEnabled-method">
<db:title>bool navEnabled(object <db:emphasis>navData</db:emphasis>, array <db:emphasis>values</db:emphasis>)</db:title>
<db:para>取得導覽項目是否啟用。</db:para>
<db:para>可覆寫。</db:para>
</db:section>
<db:section xml:id="navNotified-method">
<db:title>bool navNotified(object <db:emphasis>navData</db:emphasis>, array <db:emphasis>values</db:emphasis>)</db:title>
<db:para>取得導覽項目是否顯示通知提示。</db:para>
<db:para>可覆寫。</db:para>
</db:section>
<db:section xml:id="navVisible-method">
<db:title>bool navVisible(object <db:emphasis>navData</db:emphasis>, array <db:emphasis>values</db:emphasis>)</db:title>
<db:para>取得導覽項目是否顯示。</db:para>
<db:para>可覆寫。</db:para>
</db:section>
<db:section xml:id="selectFirstFunc-method">
<db:title>void selectFirstFunc()</db:title>
<db:para>選取第一個根導覽項目。</db:para>
<db:para>若存在子節點，會自動遞迴選取第一個子項目。</db:para>
</db:section>
<db:section xml:id="selectFunc-method">
<db:title>void selectFunc(array <db:emphasis>values</db:emphasis>)</db:title>
<db:para>依據指定路徑選取導覽項目。</db:para>
<db:para><db:code role="parameter">values</db:code> 導覽路徑陣列。</db:para>
<db:para>若路徑不存在，<db:link xlink:href="qml-sc-navigationfunclist.xml#currentValues-prop">currentValues</db:link> 會被清空。</db:para>
</db:section>
</db:section>
</db:article>
