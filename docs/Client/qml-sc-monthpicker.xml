<?xml version="1.0" encoding="UTF-8"?>
<db:article xmlns:db="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.2" xml:lang="en">
<db:info>
<db:title>MonthPicker QML Type</db:title>
<db:productname>EdgeView</db:productname>
<db:titleabbrev>EdgeView</db:titleabbrev>
<db:abstract>
<db:para>月份選擇器元件。.</db:para>
<db:para>This type was introduced in Qt 6.8.</db:para>
</db:abstract>
</db:info>
<db:variablelist>
<db:varlistentry>
<db:term>Import Statement</db:term>
<db:listitem>
<db:para>import SC</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Since:</db:term>
<db:listitem>
<db:para>Qt 6.8</db:para>
</db:listitem>
</db:varlistentry>
</db:variablelist>
<db:section xml:id="details">
<db:title>Detailed Description</db:title>
<db:para>支援功能：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>主題樣式控制（<db:link xlink:href="">themeName）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>多尺寸顯示（<db:link xlink:href="">sizeType）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>年份 切換控制</db:para>
</db:listitem>
<db:listitem>
<db:para>自訂月份狀態（selected / disabled）</db:para>
</db:listitem>
</db:itemizedlist>
</db:section>
<db:section xml:id="property-documentation">
<db:title>Property Documentation</db:title>
<db:section xml:id="cellBottomPadding-prop">
<db:title>cellBottomPadding : real</db:title>
<db:para>月份下方邊距。</db:para>
</db:section>
<db:section xml:id="cellHorizontalPadding-prop">
<db:title>cellHorizontalPadding : real</db:title>
<db:para>月份水平邊距。</db:para>
</db:section>
<db:section xml:id="cellLeftPadding-prop">
<db:title>cellLeftPadding : real</db:title>
<db:para>月份左方邊距。</db:para>
</db:section>
<db:section xml:id="cellPadding-prop">
<db:title>cellPadding : real</db:title>
<db:para>月份邊距。</db:para>
</db:section>
<db:section xml:id="cellRightPadding-prop">
<db:title>cellRightPadding : real</db:title>
<db:para>月份右方邊距。</db:para>
</db:section>
<db:section xml:id="cellSpacing-prop">
<db:title>cellSpacing : real</db:title>
<db:para>月份間距。</db:para>
</db:section>
<db:section xml:id="cellTopPadding-prop">
<db:title>cellTopPadding : real</db:title>
<db:para>月份上方邊距。</db:para>
</db:section>
<db:section xml:id="cellVerticalPadding-prop">
<db:title>cellVerticalPadding : real</db:title>
<db:para>月份垂直邊距。</db:para>
</db:section>
<db:section xml:id="currentYear-prop">
<db:title>currentYear : int</db:title>
<db:para>目前顯示的年份。</db:para>
</db:section>
<db:section xml:id="maxCellAdvanceWidth-prop">
<db:title>[read-only] maxCellAdvanceWidth : real</db:title>
<db:para>月份按鈕最大寬度，用於對齊。</db:para>
</db:section>
<db:section xml:id="monthList-prop">
<db:title>[read-only] monthList : var</db:title>
<db:para>月份清單（0–11）。</db:para>
</db:section>
<db:section xml:id="sizeType-prop">
<db:title>sizeType : enumeration</db:title>
<db:para>尺寸類型，控制顯示的大小。</db:para>
<db:para>預設會從父元件繼承，若未提供則依據 Global.mobile 決定：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>true → Define.SizeType.Small</db:para>
</db:listitem>
<db:listitem>
<db:para>false → Define.SizeType.Medium</db:para>
</db:listitem>
</db:itemizedlist>
<db:informaltable style="generic">
<db:thead>
<db:tr>
<db:th>
<db:para>Constant</db:para>
</db:th>
<db:th>
<db:para>Description</db:para>
</db:th>
</db:tr>
</db:thead>
<db:tr valign="top">
<db:td>
<db:para>Define.SizeType.Small</db:para>
</db:td>
<db:td>
<db:para>小尺寸</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>Define.SizeType.Medium</db:para>
</db:td>
<db:td>
<db:para>中尺寸</db:para>
</db:td>
</db:tr>
</db:informaltable>
</db:section>
<db:section xml:id="themeName-prop">
<db:title>themeName : string</db:title>
<db:para>主題名稱。</db:para>
<db:para>預設會從父元件繼承，若未提供則使用 WATheme.systemThemeName。</db:para>
</db:section>
<db:section xml:id="themeStyle-prop">
<db:title>[read-only] themeStyle : var</db:title>
<db:para>主題樣式設定物件。</db:para>
<db:para>此屬性為唯讀，透過 <db:link xlink:href="qml-sc-monthpicker.xml#getThemeStyle-method">getThemeStyle</db:link>() 動態產生。</db:para>
</db:section>
</db:section>
<db:section xml:id="signal-documentation">
<db:title>Signal Documentation</db:title>
<db:section xml:id="monthClicked-signal">
<db:title>monthClicked(int <db:emphasis>year</db:emphasis>, int <db:emphasis>month</db:emphasis>)</db:title>
<db:para>點擊月份時觸發。</db:para>
<db:note>
<db:para>The corresponding handler is <db:code>onMonthClicked</db:code>.</db:para>
</db:note>
</db:section>
<db:section xml:id="yearClicked-signal">
<db:title>yearClicked()</db:title>
<db:para>點擊年份按鈕時觸發。</db:para>
<db:note>
<db:para>The corresponding handler is <db:code>onYearClicked</db:code>.</db:para>
</db:note>
</db:section>
</db:section>
<db:section xml:id="method-documentation">
<db:title>Method Documentation</db:title>
<db:section xml:id="getThemeStyle-method">
<db:title>object getThemeStyle()</db:title>
<db:para>取得主題樣式設定物件。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>return</db:code></db:emphasis>主題樣式設定物件。</db:para>
</db:section>
<db:section xml:id="monthDisabled-method">
<db:title>bool monthDisabled(<db:emphasis>month</db:emphasis>)</db:title>
<db:para>判斷月份是否停用。</db:para>
<db:para>可覆寫此方法以自訂邏輯。</db:para>
</db:section>
<db:section xml:id="monthSelected-method">
<db:title>bool monthSelected(<db:emphasis>month</db:emphasis>)</db:title>
<db:para>判斷月份是否為選取狀態。</db:para>
<db:para>可覆寫此方法以自訂邏輯。</db:para>
</db:section>
<db:section xml:id="monthShortI18NText-method">
<db:title>string monthShortI18NText(int <db:emphasis>month</db:emphasis>)</db:title>
<db:para>取得月份縮寫文字（i18n）。</db:para>
<db:para><db:code role="parameter">month</db:code> 範圍為 0–11。</db:para>
</db:section>
<db:section xml:id="nextYearClickedHandler-method">
<db:title>void nextYearClickedHandler()</db:title>
<db:para>切換到下一年。</db:para>
</db:section>
<db:section xml:id="prevYearClickedHandler-method">
<db:title>void prevYearClickedHandler()</db:title>
<db:para>切換到上一年。</db:para>
</db:section>
</db:section>
</db:article>
