<?xml version="1.0" encoding="UTF-8"?>
<db:article xmlns:db="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.2" xml:lang="en">
<db:info>
<db:title>ButtonSearchTrigger QML Type</db:title>
<db:productname>EdgeView</db:productname>
<db:titleabbrev>EdgeView</db:titleabbrev>
<db:abstract>
<db:para>搜尋觸發按鈕。.</db:para>
<db:para>This type was introduced in Qt 6.8.</db:para>
</db:abstract>
</db:info>
<db:variablelist>
<db:varlistentry>
<db:term>Import Statement</db:term>
<db:listitem>
<db:para>import SC</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Since:</db:term>
<db:listitem>
<db:para>Qt 6.8</db:para>
</db:listitem>
</db:varlistentry>
</db:variablelist>
<db:section xml:id="details">
<db:title>Detailed Description</db:title>
<db:para>UI 中，提供包含圖示與文字的搜尋觸發按鈕，作為搜尋 UI 的入口控制元件。</db:para>
<db:para>支援功能：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>主題樣式控制（<db:link xlink:href="">themeName）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>文字顯示（<db:link xlink:href="">text）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>圖示顯示（<db:link xlink:href="">iconSourceUrl）</db:link></db:para>
</db:listitem>
</db:itemizedlist>
<db:para>元件內建互動狀態：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>normal</db:para>
</db:listitem>
<db:listitem>
<db:para>hover</db:para>
</db:listitem>
<db:listitem>
<db:para>active</db:para>
</db:listitem>
<db:listitem>
<db:para>disable</db:para>
</db:listitem>
</db:itemizedlist>
<db:para>各狀態會繼承對應的 base state（例如 normal → normalbase）， 並透過 <db:link xlink:href="qml-sc-buttonsearchtrigger.xml#themeStyle-prop">themeStyle</db:link> 套用背景、邊框與內容顏色等。</db:para>
</db:section>
<db:section xml:id="property-documentation">
<db:title>Property Documentation</db:title>
<db:section xml:id="activeState-prop">
<db:title>activeState : State</db:title>
<db:para>active 狀態設定。</db:para>
</db:section>
<db:section xml:id="actived-prop">
<db:title>actived : bool</db:title>
<db:para>是否為 active。</db:para>
<db:para>預設綁定 pressed。</db:para>
</db:section>
<db:section xml:id="bdColor-prop">
<db:title>bdColor : StateColor</db:title>
<db:para>各狀態邊框顏色設定。</db:para>
</db:section>
<db:section xml:id="bgColor-prop">
<db:title>bgColor : StateColor</db:title>
<db:para>各狀態背景顏色設定。</db:para>
</db:section>
<db:section xml:id="bgCoverGradient-prop">
<db:title>bgCoverGradient : StateGradient</db:title>
<db:para>各狀態背景漸層設定。</db:para>
</db:section>
<db:section xml:id="disableState-prop">
<db:title>disableState : State</db:title>
<db:para>disable 狀態設定。</db:para>
</db:section>
<db:section xml:id="hoverState-prop">
<db:title>hoverState : State</db:title>
<db:para>hover 狀態設定。</db:para>
</db:section>
<db:section xml:id="iconColor-prop">
<db:title>iconColor : StateColor</db:title>
<db:para>各狀態圖示顏色設定。</db:para>
</db:section>
<db:section xml:id="iconSourceUrl-prop">
<db:title>iconSourceUrl : url</db:title>
<db:para>圖示來源 URL。</db:para>
<db:para>詳細格式與限制請參考 Qt 官方文件。</db:para>
</db:section>
<db:section xml:id="normalState-prop">
<db:title>normalState : State</db:title>
<db:para>normal 狀態設定。</db:para>
</db:section>
<db:section xml:id="radius-prop">
<db:title>radius : real</db:title>
<db:para>按鈕圓角半徑。</db:para>
<db:para>預設 4。</db:para>
</db:section>
<db:section xml:id="themeName-prop">
<db:title>themeName : string</db:title>
<db:para>主題名稱。</db:para>
<db:para>預設會從父元件繼承，若未提供則使用 WATheme.systemThemeName。</db:para>
</db:section>
<db:section xml:id="themeStyle-prop">
<db:title>[read-only] themeStyle : var</db:title>
<db:para>主題樣式設定物件。</db:para>
<db:para>此屬性為唯讀，透過 <db:link xlink:href="qml-sc-buttonsearchtrigger.xml#getThemeStyle-method">getThemeStyle</db:link>() 動態產生。</db:para>
</db:section>
</db:section>
<db:section xml:id="method-documentation">
<db:title>Method Documentation</db:title>
<db:section xml:id="getThemeStyle-method">
<db:title>object getThemeStyle()</db:title>
<db:para>取得主題樣式設定物件。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>return</db:code></db:emphasis>主題樣式設定物件。</db:para>
</db:section>
</db:section>
</db:article>
