<?xml version="1.0" encoding="UTF-8"?>
<db:article xmlns:db="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.2" xml:lang="en">
<db:info>
<db:title>WAListView QML Type</db:title>
<db:productname>EdgeView</db:productname>
<db:titleabbrev>EdgeView</db:titleabbrev>
<db:abstract>
<db:para>自訂 ListView。.</db:para>
<db:para>This type was introduced in Qt 6.8.</db:para>
</db:abstract>
</db:info>
<db:variablelist>
<db:varlistentry>
<db:term>Import Statement</db:term>
<db:listitem>
<db:para>import SC</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Since:</db:term>
<db:listitem>
<db:para>Qt 6.8</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Inherited By:</db:term>
<db:listitem>
<db:para><db:link xlink:href="qml-sc-selector.xml" xlink:role="">Selector</db:link>, <db:link xlink:href="qml-sc-selectormultiple.xml" xlink:role="">SelectorMultiple</db:link>, and <db:link xlink:href="qml-sc-timepresetpicker.xml" xlink:role="">TimePresetPicker</db:link></db:para>
</db:listitem>
</db:varlistentry>
</db:variablelist>
<db:section xml:id="details">
<db:title>Detailed Description</db:title>
<db:para>ScrollBar 進行樣式客製。</db:para>
<db:para>此元件延續 SC 主題系統（<db:link xlink:href="qml-sc-walistview.xml#themeName-prop">themeName</db:link> / <db:link xlink:href="">themeStyle），</db:link> 使 ScrollBar 的顏色與風格能統一管理。</db:para>
<db:para>支援功能：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>垂直與水平滾動</db:para>
</db:listitem>
<db:listitem>
<db:para>自動顯示/隱藏捲軸（依內容尺寸判斷）</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>垂直捲軸：當 contentHeight &gt; height 時顯示</db:para>
</db:listitem>
<db:listitem>
<db:para>水平捲軸：當 contentWidth &gt; width 時顯示</db:para>
</db:listitem>
</db:itemizedlist>
</db:listitem>
<db:listitem>
<db:para>自訂捲軸（<db:link xlink:href="qml-sc-walistview.xml#scrollBarWidth-prop">scrollBarWidth</db:link>, <db:link xlink:href="">scrollBarColor）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>主題樣式控制（<db:link xlink:href="">themeName）</db:link></db:para>
</db:listitem>
</db:itemizedlist>
</db:section>
<db:section xml:id="property-documentation">
<db:title>Property Documentation</db:title>
<db:section xml:id="scrollBarColor-prop">
<db:title>scrollBarColor : color</db:title>
<db:para>捲軸顏色。</db:para>
</db:section>
<db:section xml:id="scrollBarWidth-prop">
<db:title>scrollBarWidth : real</db:title>
<db:para>捲軸寬度。</db:para>
</db:section>
<db:section xml:id="themeName-prop">
<db:title>themeName : string</db:title>
<db:para>主題名稱。</db:para>
<db:para>預設會從父元件繼承，若未提供則使用 WATheme.systemThemeName。</db:para>
</db:section>
<db:section xml:id="themeStyle-prop">
<db:title>[read-only] themeStyle : var</db:title>
<db:para>主題樣式設定物件。</db:para>
<db:para>此屬性為唯讀，透過 <db:link xlink:href="qml-sc-walistview.xml#getThemeStyle-method">getThemeStyle</db:link>() 動態產生。</db:para>
</db:section>
</db:section>
<db:section xml:id="method-documentation">
<db:title>Method Documentation</db:title>
<db:section xml:id="getThemeStyle-method">
<db:title>object getThemeStyle()</db:title>
<db:para>取得主題樣式設定物件。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>return</db:code></db:emphasis>主題樣式設定物件。</db:para>
</db:section>
</db:section>
</db:article>
