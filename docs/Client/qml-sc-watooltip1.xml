<?xml version="1.0" encoding="UTF-8"?>
<db:article xmlns:db="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.2" xml:lang="en">
<db:info>
<db:title>WAToolTip1 QML Type</db:title>
<db:productname>EdgeView</db:productname>
<db:titleabbrev>EdgeView</db:titleabbrev>
<db:abstract>
<db:para>提示框元件。.</db:para>
<db:para>This type was introduced in Qt 6.8.</db:para>
</db:abstract>
</db:info>
<db:variablelist>
<db:varlistentry>
<db:term>Import Statement</db:term>
<db:listitem>
<db:para>import SC</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Since:</db:term>
<db:listitem>
<db:para>Qt 6.8</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Inherited By:</db:term>
<db:listitem>
<db:para><db:link xlink:href="qml-sc-watooltiptext.xml" xlink:role="">WAToolTipText</db:link> and <db:link xlink:href="qml-sc-watooltipthumbnail.xml" xlink:role="">WAToolTipThumbnail</db:link></db:para>
</db:listitem>
</db:varlistentry>
</db:variablelist>
<db:section xml:id="details">
<db:title>Detailed Description</db:title>
<db:para>為 ToolTip 的擴充元件，提供符合系統樣式的提示框。</db:para>
<db:para>支援功能：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>主題樣式控制（<db:link xlink:href="">themeName）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>多尺寸顯示（<db:link xlink:href="">sizeType）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>背景效果與樣式顯示（<db:link xlink:href="">colorType）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>位置控制（<db:link xlink:href="qml-sc-watooltip1.xml#horizontalAlign-prop">horizontalAlign</db:link>, <db:link xlink:href="">verticalAlign）</db:link></db:para>
</db:listitem>
</db:itemizedlist>
</db:section>
<db:section xml:id="property-documentation">
<db:title>Property Documentation</db:title>
<db:section xml:id="colorType-prop">
<db:title>colorType : enumeration</db:title>
<db:para>背景顏色類型（由 WAColor 定義）。</db:para>
<db:para>預設 WAColor.ColorType.Gray。</db:para>
</db:section>
<db:section xml:id="horizontalAlign-prop">
<db:title>horizontalAlign : enumeration</db:title>
<db:para>水平對齊方式。</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>Qt.AlignLeft</db:para>
</db:listitem>
<db:listitem>
<db:para>Qt.AlignHCenter</db:para>
</db:listitem>
<db:listitem>
<db:para>Qt.AlignRight</db:para>
</db:listitem>
</db:itemizedlist>
</db:section>
<db:section xml:id="horizontalOffset-prop">
<db:title>horizontalOffset : real</db:title>
<db:para>水平偏移量。</db:para>
</db:section>
<db:section xml:id="sizeType-prop">
<db:title>sizeType : enumeration</db:title>
<db:para>尺寸類型，控制顯示的大小。</db:para>
<db:para>預設會從父元件繼承，若未提供則依據 Global.mobile 決定：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>true → Define.SizeType.Small</db:para>
</db:listitem>
<db:listitem>
<db:para>false → Define.SizeType.Medium</db:para>
</db:listitem>
</db:itemizedlist>
<db:informaltable style="generic">
<db:thead>
<db:tr>
<db:th>
<db:para>Constant</db:para>
</db:th>
<db:th>
<db:para>Description</db:para>
</db:th>
</db:tr>
</db:thead>
<db:tr valign="top">
<db:td>
<db:para>Define.SizeType.Small</db:para>
</db:td>
<db:td>
<db:para>小尺寸</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>Define.SizeType.Medium</db:para>
</db:td>
<db:td>
<db:para>中尺寸</db:para>
</db:td>
</db:tr>
</db:informaltable>
</db:section>
<db:section xml:id="themeName-prop">
<db:title>themeName : string</db:title>
<db:para>主題名稱。</db:para>
<db:para>預設會從父元件繼承，若未提供則使用 WATheme.systemThemeName。</db:para>
</db:section>
<db:section xml:id="themeStyle-prop">
<db:title>[read-only] themeStyle : var</db:title>
<db:para>主題樣式設定物件。</db:para>
<db:para>此屬性為唯讀，透過 <db:link xlink:href="qml-sc-watooltip1.xml#getThemeStyle-method">getThemeStyle</db:link>() 動態產生。</db:para>
</db:section>
<db:section xml:id="verticalAlign-prop">
<db:title>verticalAlign : enumeration</db:title>
<db:para>垂直對齊方式。</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>Qt.AlignTop</db:para>
</db:listitem>
<db:listitem>
<db:para>Qt.AlignVCenter</db:para>
</db:listitem>
<db:listitem>
<db:para>Qt.AlignBottom</db:para>
</db:listitem>
</db:itemizedlist>
</db:section>
<db:section xml:id="verticalOffset-prop">
<db:title>verticalOffset : real</db:title>
<db:para>垂直偏移量。</db:para>
</db:section>
</db:section>
<db:section xml:id="method-documentation">
<db:title>Method Documentation</db:title>
<db:section xml:id="getThemeStyle-method">
<db:title>object getThemeStyle()</db:title>
<db:para>取得主題樣式設定物件。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>return</db:code></db:emphasis>主題樣式設定物件。</db:para>
</db:section>
</db:section>
</db:article>
