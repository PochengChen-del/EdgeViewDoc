<?xml version="1.0" encoding="UTF-8"?>
<db:article xmlns:db="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.2" xml:lang="en">
<db:info>
<db:title>FormBarSubtitle QML Type</db:title>
<db:productname>EdgeView</db:productname>
<db:titleabbrev>EdgeView</db:titleabbrev>
<db:abstract>
<db:para>表單副標題文字元件。.</db:para>
<db:para>This type was introduced in Qt 6.8.</db:para>
</db:abstract>
</db:info>
<db:variablelist>
<db:varlistentry>
<db:term>Import Statement</db:term>
<db:listitem>
<db:para>import SC</db:para>
</db:listitem>
</db:varlistentry>
<db:varlistentry>
<db:term>Since:</db:term>
<db:listitem>
<db:para>Qt 6.8</db:para>
</db:listitem>
</db:varlistentry>
</db:variablelist>
<db:section xml:id="details">
<db:title>Detailed Description</db:title>
<db:para>支援功能：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>主題樣式控制（<db:link xlink:href="">themeName）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>多尺寸顯示（<db:link xlink:href="">sizeType）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>展開／收折狀態控制（<db:link xlink:href="">expanded）</db:link></db:para>
</db:listitem>
<db:listitem>
<db:para>標題、描述與標籤顯示</db:para>
</db:listitem>
<db:listitem>
<db:para>自訂操作按鈕</db:para>
</db:listitem>
</db:itemizedlist>
</db:section>
<db:section xml:id="property-documentation">
<db:title>Property Documentation</db:title>
<db:section xml:id="actions-prop">
<db:title>actions : Item</db:title>
<db:para>右側操作按鈕區域的子元件。</db:para>
</db:section>
<db:section xml:id="bottomPadding-prop">
<db:title>bottomPadding : real</db:title>
<db:para>下方邊距。</db:para>
</db:section>
<db:section xml:id="description-prop">
<db:title>description : string</db:title>
<db:para>描述文字。</db:para>
</db:section>
<db:section xml:id="expanded-prop">
<db:title>expanded : bool</db:title>
<db:para>是否展開。</db:para>
<db:para>預設 true。</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>true → 展開</db:para>
</db:listitem>
<db:listitem>
<db:para>false → 收折</db:para>
</db:listitem>
</db:itemizedlist>
</db:section>
<db:section xml:id="labelColorType-prop">
<db:title>labelColorType : enumeration</db:title>
<db:para>標籤顏色類型。</db:para>
<db:para>對應 WAColor.ColorType。</db:para>
</db:section>
<db:section xml:id="labelStyle-prop">
<db:title>labelStyle : enumeration</db:title>
<db:para>標籤樣式。</db:para>
<db:para>對應 Define.LabelStyle。</db:para>
</db:section>
<db:section xml:id="labelText-prop">
<db:title>labelText : string</db:title>
<db:para>標籤文字。</db:para>
</db:section>
<db:section xml:id="leftPadding-prop">
<db:title>leftPadding : real</db:title>
<db:para>左方邊距。</db:para>
</db:section>
<db:section xml:id="padding-prop">
<db:title>padding : real</db:title>
<db:para>邊距。</db:para>
</db:section>
<db:section xml:id="rightPadding-prop">
<db:title>rightPadding : real</db:title>
<db:para>右方邊距。</db:para>
</db:section>
<db:section xml:id="showActions-prop">
<db:title>showActions : bool</db:title>
<db:para>是否顯示右側操作按鈕區域。</db:para>
</db:section>
<db:section xml:id="showDescription-prop">
<db:title>showDescription : bool</db:title>
<db:para>是否顯示描述文字。</db:para>
</db:section>
<db:section xml:id="showFold-prop">
<db:title>showFold : bool</db:title>
<db:para>是否顯示收折按鈕。</db:para>
</db:section>
<db:section xml:id="showLabel-prop">
<db:title>showLabel : bool</db:title>
<db:para>是否顯示標籤。</db:para>
</db:section>
<db:section xml:id="sizeType-prop">
<db:title>sizeType : enumeration</db:title>
<db:para>尺寸類型，控制顯示的大小。</db:para>
<db:para>預設會從父元件繼承，若未提供則依據 Global.mobile 決定：</db:para>
<db:itemizedlist>
<db:listitem>
<db:para>true → Define.SizeType.Small</db:para>
</db:listitem>
<db:listitem>
<db:para>false → Define.SizeType.Medium</db:para>
</db:listitem>
</db:itemizedlist>
<db:informaltable style="generic">
<db:thead>
<db:tr>
<db:th>
<db:para>Constant</db:para>
</db:th>
<db:th>
<db:para>Description</db:para>
</db:th>
</db:tr>
</db:thead>
<db:tr valign="top">
<db:td>
<db:para>Define.SizeType.Small</db:para>
</db:td>
<db:td>
<db:para>小尺寸</db:para>
</db:td>
</db:tr>
<db:tr valign="top">
<db:td>
<db:para>Define.SizeType.Medium</db:para>
</db:td>
<db:td>
<db:para>中尺寸</db:para>
</db:td>
</db:tr>
</db:informaltable>
</db:section>
<db:section xml:id="themeName-prop">
<db:title>themeName : string</db:title>
<db:para>主題名稱。</db:para>
<db:para>預設會從父元件繼承，若未提供則使用 WATheme.systemThemeName。</db:para>
</db:section>
<db:section xml:id="themeStyle-prop">
<db:title>[read-only] themeStyle : var</db:title>
<db:para>主題樣式設定物件。</db:para>
<db:para>此屬性為唯讀，透過 <db:link xlink:href="qml-sc-formbarsubtitle.xml#getThemeStyle-method">getThemeStyle</db:link>() 動態產生。</db:para>
</db:section>
<db:section xml:id="title-prop">
<db:title>title : string</db:title>
<db:para>標題文字。</db:para>
</db:section>
<db:section xml:id="topPadding-prop">
<db:title>topPadding : real</db:title>
<db:para>上方邊距。</db:para>
</db:section>
</db:section>
<db:section xml:id="method-documentation">
<db:title>Method Documentation</db:title>
<db:section xml:id="getThemeStyle-method">
<db:title>object getThemeStyle()</db:title>
<db:para>取得主題樣式設定物件。</db:para>
<db:para><db:emphasis role="bold">&lt;Unknown command&gt;<db:code>return</db:code></db:emphasis>主題樣式設定物件。</db:para>
</db:section>
</db:section>
</db:article>
